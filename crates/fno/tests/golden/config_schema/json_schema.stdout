    "SidelineBlock": {
      "description": "Sideline render config (nested under 'config.sideline').",
      "properties": {
        "colors": {
          "$ref": "#/$defs/SidelineColorsBlock"
        },
        "layout": {
          "default": "card",
          "enum": [
            "card",
            "list"
