        "a2a": {
          "$ref": "#/$defs/A2aBlock"
        },
        "auto_register_sessions": {
          "default": false,
          "title": "Auto Register Sessions",
          "type": "boolean"
        },
        "claude": {
          "$ref": "#/$defs/AgentBeatBlock"
        },
        "codex": {
