          "type": "integer"
        },
        "max_failed_attempts": {
          "default": 3,
          "title": "Max Failed Attempts",
          "type": "integer"
        },
        "staleness_days": {
          "default": 30,
          "title": "Staleness Days",
          "type": "integer"
        },
        "validity_batch_size": {
          "default": 25,
          "title": "Validity Batch Size",
          "type": "integer"
        },
        "validity_days": {
          "default": 60,
          "title": "Validity Days",
          "type": "integer"
        }
      },
      "title": "MaintainBlock",
      "type": "object"
    },
    "ModelProvider": {
