    "PostMergeBlock": {
      "description": "Post-merge ritual settings (nested under 'config.post_merge').\n\nDrives the /fno:ship pr merged skill: where to write prose follow-up\ntodos after a PR merges, and whether the ritual is enabled for this repo.\n\n`parking_lot_path` is repo-relative. The vault-area name does NOT equal the\nproject name (e.g. example-pipeline -> internal/etl/backlog/parking-lot.md),\nso it must be set explicitly per repo and is never derived from the project\nname. Left unset by default so a repo that has not opted in resolves to an\nempty value and the skill fails loud rather than guessing a path.",
      "properties": {
        "auto_run": {
          "default": false,
          "title": "Auto Run",
          "type": "boolean"
        },
        "catchup_window_days": {
          "default": 3,
          "title": "Catchup Window Days",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "maintainer_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maintainer Marker"
        },
        "model": {
          "default": "claude-opus-5",
          "title": "Model",
          "type": "string"
        },
        "parking_lot_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parking Lot Path"
        },
        "self_reap": {
          "default": false,
          "title": "Self Reap",
          "type": "boolean"
        },
        "sync_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sync Command"
        },
        "sync_paths": {
          "items": {
            "type": "string"
          },
          "title": "Sync Paths",
          "type": "array"
        },
        "sync_stale_hours": {
          "default": 24,
          "title": "Sync Stale Hours",
          "type": "integer"
        }
      },
      "title": "PostMergeBlock",
      "type": "object"
    },
    "PrWatchBlock": {
      "description": "PR-state watcher settings (nested under 'config.pr_watch').\n\nControls the global launchd watcher that polls open-PR backlog nodes\nand fires headless /fno:ship pr check / /fno:ship pr merged.\n\nFields: enabled (operator opt-in, default False); interval_seconds\n(plist StartInterval, default 600); retries (consecutive dispatch\nfailures before a PR parks, default 3); max_age_days (default 14);\nmodel (headless skill-fire model, default claude-haiku-4-5);\ntick_timeout_seconds (wall clock per tick; unset derives\nmax(60, 0.8 * interval_seconds) so launchd never suppresses the next\ntick); graphql_min_remaining (dispatch-pass skip floor on the shared\nGraphQL budget, default 200); wedged_after_ticks (consecutive broken\ntick ends at a fresh watermark before liveness reads wedged, default\n3; one broken tick is transient).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "graphql_min_remaining": {
          "default": 200,
          "minimum": 0,
          "title": "Graphql Min Remaining",
          "type": "integer"
        },
        "interval_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Interval Seconds",
          "type": "integer"
        },
        "max_age_days": {
          "default": 14,
          "minimum": 1,
          "title": "Max Age Days",
          "type": "integer"
        },
        "model": {
          "default": "claude-haiku-4-5",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "retries": {
          "default": 3,
          "minimum": 1,
          "title": "Retries",
          "type": "integer"
        },
        "tick_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tick Timeout Seconds"
        },
        "wedged_after_ticks": {
          "default": 3,
          "minimum": 1,
          "title": "Wedged After Ticks",
          "type": "integer"
        }
      },
      "title": "PrWatchBlock",
      "type": "object"
    },
    "PreflightBlock": {
      "description": "Local preflight policy (nested under 'config.preflight').\n\n``required`` decides whether a full local ``scripts/ci/preflight.sh``\nreceipt is REQUIRED before a PR is opened. Default false: CI is the merge\ngate, and a 22-to-47-minute local rehearsal of it is an optimisation,\nnever the authority. Six concurrent runs at load average 415 with zero\ncompletions (2026-08-19) is the measurement that set this default. Set\ntrue to restore the mandatory rehearsal per project.",
      "properties": {
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "title": "PreflightBlock",
      "type": "object"
    },
    "ProcessAdmissionBlock": {
      "description": "The agent-spawn door's process ceiling, expressed only in OS processes.",
      "properties": {
        "max_processes": {
          "default": 400,
          "title": "Max Processes",
          "type": "integer"
        }
      },
      "title": "ProcessAdmissionBlock",
      "type": "object"
    },
    "ProjectBlock": {
      "description": "Project identity settings.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "vision": {
          "anyOf": [
            {
              "type": "string"
