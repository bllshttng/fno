        },
        "confirm": {
          "default": "auto",
          "title": "Confirm",
          "type": "string"
        },
        "defaults": {
          "$ref": "#/$defs/SpawnDefaultsBlock"
        },
        "fallback": {
          "additionalProperties": true,
          "title": "Fallback",
          "type": "object"
        },
        "first_check_minutes": {
          "default": 10,
          "maximum": 60,
          "minimum": 1,
          "title": "First Check Minutes",
          "type": "integer"
        },
        "footprint_sustained_cpu_cores": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
