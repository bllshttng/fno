          "type": "integer"
        }
      },
      "title": "FailoverBlock",
      "type": "object"
    },
    "GroomBlock": {
      "description": "Daily backlog-grooming pass settings (nested under 'config.groom').\n\nwave 2: `fno backlog groom` (`spawn_worker` in\n   crates/fno-agents/src/backlog/groom.rs) previously spawned with no enable key at all, so it\n   could not be turned off. Default ``True`` matches the spawner's CURRENT\n   effective behavior (it always ran) - shipping this gate changes nothing\n   for an existing user until they explicitly disable it.\n   ",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "GroomBlock",
      "type": "object"
    },
    "GuardsBlock": {
      "description": "Which gatable guards run for this project.\n\n``strict`` runs every gatable guard, ``standard`` keeps the two\ndestructive-write guards on, ``off`` runs none. The state-integrity guards\nnever gate in any preset. A malformed value reads as ``strict`` in Rust.",
      "properties": {
        "preset": {
          "default": "standard",
          "enum": [
            "strict",
            "standard",
            "off"
          ],
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "GuardsBlock",
      "type": "object"
    },
    "HandoffBlock": {
      "description": "Capability escalation plus the shared context-compact thresholds.\n\n``enabled`` gates the explicit escalation transaction. Context pressure is\nhandled by ``hooks/context-nudge.sh`` and compaction, never by succession.\nThe historical generation knob is intentionally absent: one externally\nselected destination is one escalation rung.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "lead_used_pct_trigger": {
          "default": 40,
          "title": "Lead Used Pct Trigger",
          "type": "integer"
        },
        "used_pct_trigger": {
          "default": 50,
          "title": "Used Pct Trigger",
          "type": "integer"
        }
      },
      "title": "HandoffBlock",
      "type": "object"
    },
    "HarnessOverlayBlock": {
      "additionalProperties": true,
      "description": "One harness's answers under a spawn-defaults block.\n\nPrecedence: explicit flag > lane > ``profiles.<command>.harness.<h>`` >\n``profiles.<command>`` > ``defaults.harness.<h>`` > ``defaults``. A\npermission/effort value spells the HARNESS's own flags, so the answer\nlives keyed by harness; ranking fields are refused at the spawn seam.\n``extra=\"allow\"`` is deliberate: a smuggled lane field must survive load\nso the seam can name it in its refusal.",
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "effort": {
          "default": "",
          "title": "Effort",
          "type": "string"
        },
        "permission_mode": {
          "default": "",
          "title": "Permission Mode",
          "type": "string"
        },
        "substrate": {
          "default": "",
          "title": "Substrate",
          "type": "string"
        }
      },
      "title": "HarnessOverlayBlock",
      "type": "object"
    },
    "HealthHistoryBlock": {
      "description": "Backlog-health history retention (config.health_monitor.history).\n\n``path`` defaults to None and is resolved at runtime via paths.state_dir().",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
