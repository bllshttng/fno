        },
        "happy_routed_panes": {
          "default": false,
          "title": "Happy Routed Panes",
          "type": "boolean"
        },
        "hold_escalate_after_s": {
          "default": 5400,
          "minimum": 0,
          "title": "Hold Escalate After S",
