    },
    "SidelineColorsBlock": {
      "additionalProperties": false,
      "description": "Lane-color tables for the mux sideline (nested under 'config.sideline.colors').\n\nEvery key names its axis explicitly - ``harness.<name>``,\n   ``route.<name>``, ``model.\"<model string>\"``, ``row.<routing-row name>`` -\n   because a bare key is ambiguous between account, route and model, and an\n   axis is never inferred from a value. ``extra='forbid'`` is the refusal: a\n   bare ``zai = \"green\"`` under this table is a config ERROR naming the four\n   legal axis tables, not a silently ignored guess.\n\n   Values are color names the Rust reader parses (ANSI-16 names,\n   ``indexed(<n>)``, ``#rrggbb``). Resolution happens in\n   ``crates/fno/src/sideline_color.rs`` through one fixed cascade - routing\n   row, then model, then route, then harness, then the built-in table - and\n   an unknown color name falls THROUGH the cascade rather than blanking a\n   row, so a typo here can never mis-color the sideline.\n   ",
      "properties": {
        "harness": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Harness",
          "type": "object"
        },
        "model": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Model",
          "type": "object"
        },
        "route": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Route",
          "type": "object"
        },
        "row": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Row",
          "type": "object"
        }
      },
      "title": "SidelineColorsBlock",
      "type": "object"
    },
    "SpawnDefaultsBlock": {
      "description": "Default spawn routing (nested under 'config.agents.defaults').\n\nThe bottom-most operator rung of the spawn precedence chain: an explicit\nCLI flag > these defaults > the built-in. Every bare `fno agents spawn`\ninherits any field set here, autonomous dispatch included; an unpinned\n`model` or `effort` DOES inherit. Empty string = unset. No value\nvalidation here: config stays a leaf module ; provider and effort\nare checked at the spawn seam. `route`/`account` sit beside the legacy\n`provider` field (ruling 4), which keeps meaning harness.",
      "properties": {
        "account": {
          "default": "",
          "title": "Account",
          "type": "string"
        },
        "effort": {
          "default": "",
          "title": "Effort",
          "type": "string"
        },
        "harness": {
          "additionalProperties": {
            "$ref": "#/$defs/HarnessOverlayBlock"
          },
          "title": "Harness",
          "type": "object"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "permission_mode": {
          "default": "",
          "title": "Permission Mode",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "route": {
          "default": "",
          "title": "Route",
          "type": "string"
        },
        "substrate": {
          "default": "",
          "title": "Substrate",
          "type": "string"
        }
      },
      "title": "SpawnDefaultsBlock",
      "type": "object"
    },
