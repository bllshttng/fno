    "StatusFanoutConfig": {
      "description": "Fanout dispatcher tuning (config.status_fanout).\n\nNon-positive tuning values fail loud at config load (matching this file's\nconvention) rather than reaching ``urllib`` as a negative timeout - which\nraises deep inside a per-sink try/except and silently drops every event.",
      "properties": {
        "http_timeout_secs": {
          "default": 5,
          "minimum": 1,
          "title": "Http Timeout Secs",
          "type": "integer"
        },
        "interval_secs": {
          "default": 5,
          "minimum": 1,
          "title": "Interval Secs",
          "type": "integer"
        },
        "retries": {
          "default": 2,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "short_circuit_backoff_secs": {
          "default": 300,
          "minimum": 0,
          "title": "Short Circuit Backoff Secs",
          "type": "integer"
        }
      },
      "title": "StatusFanoutConfig",
      "type": "object"
    },
    "StatusSinkConfig": {
      "description": "One status sink (``config.status_sinks[]``).\n\nSemantic errors (unknown type, out-of-whitelist ``match`` key, both/neither\nof ``url``/``url_env``, duplicate ``name`` across the list) RAISE at config\nload - a misconfigured sink fails loud rather than silently not delivering.\nA container-level type mismatch (a scalar where the list belongs) still\nfails safe to ``[]`` in ``ConfigBlock`` so a typo never bricks settings load.",
      "properties": {
        "cloudevents": {
          "default": false,
          "title": "Cloudevents",
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "events": {
          "items": {
            "type": "string"
          },
          "title": "Events",
          "type": "array"
        },
        "field": {
          "default": "content",
          "title": "Field",
          "type": "string"
        },
        "match": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Match",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "raw_body": {
          "default": false,
          "title": "Raw Body",
          "type": "boolean"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "url_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url Env"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "StatusSinkConfig",
      "type": "object"
    },
    "StoreBlock": {
      "description": "The libSQL (sqld) primary that every machine dials out to.",
      "properties": {
        "remote_addrs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Addrs"
        },
        "remote_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Token"
        },
        "remote_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Url"
        },
        "share_backlog": {
          "default": false,
          "title": "Share Backlog",
          "type": "boolean"
        },
        "ssh_peers": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ssh Peers"
        }
      },
      "title": "StoreBlock",
      "type": "object"
    },
    "StyleBlock": {
      "description": "Style-checker numbers (nested under 'config.style').",
      "properties": {
        "word_cap": {
          "$ref": "#/$defs/WordCapBlock"
        }
      },
      "title": "StyleBlock",
      "type": "object"
    },
    "TargetConfig": {
      "description": "Target pipeline settings (nested under 'config.target').\n\n`dedupe_dead_duplicates` (Component B) gates the stop hook's\nopt-in cleanup of provably-dead duplicate sibling target-state.md files.\nWhen two worktrees of one repo carry an IN_PROGRESS state bound to the same\nclaude_transcript_id, enabling this lets the stop hook rename the\nprovably-dead sibling to `*.superseded` (recoverable) after a transcript-id\nbackfill - but only when it is not the live worktree, its owner_pid is dead,\nand it is older than the current state. Default OFF: the non-destructive\nresolution-time tiebreak (Component A) alone fixes the p1 false-orphan; this\nis an incremental hygiene layer.",
      "properties": {
        "blast": {
          "$ref": "#/$defs/BlastConfig"
        },
        "dedupe_dead_duplicates": {
          "default": false,
          "title": "Dedupe Dead Duplicates",
          "type": "boolean"
        },
        "defaults": {
          "$ref": "#/$defs/TargetDefaultsBlock"
        },
        "handoff": {
          "$ref": "#/$defs/HandoffBlock"
        }
      },
      "title": "TargetConfig",
      "type": "object"
    },
    "TargetDefaultsBlock": {
      "description": "Session-input defaults (nested under 'config.target.defaults').\n\nThese are NOT pipeline config: they are the default *values* a /target\nsession starts with when the CLI flag / env override is absent. They are\nenumerated here so they appear in the generated docs as \"session-input\ndefaults\", but the runtime values are still resolved from the size profile\nand TARGET_NO_* env overrides at session init - this block only documents\nthe fallbacks. `budget_cap` was intentionally NOT modeled (Locked Decision\n10): cost accounting is not yet a dependable control.",
      "properties": {
        "max_iterations": {
          "default": 40,
          "title": "Max Iterations",
          "type": "integer"
        },
        "no_docs": {
          "default": false,
          "title": "No Docs",
          "type": "boolean"
        },
        "no_external": {
          "default": false,
          "title": "No External",
          "type": "boolean"
        }
      },
      "title": "TargetDefaultsBlock",
      "type": "object"
    },
    "TelemetryBlock": {
      "properties": {
        "claude_otel": {
          "default": true,
          "title": "Claude Otel",
          "type": "boolean"
        },
        "otlp": {
          "$ref": "#/$defs/TelemetryOtlpBlock"
        }
      },
      "title": "TelemetryBlock",
      "type": "object"
    },
    "TelemetryOtlpBlock": {
      "description": "OTLP log export. ``headers_env`` names the env var holding the auth headers.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "default": "",
          "title": "Endpoint",
          "type": "string"
        },
        "headers_env": {
          "default": "FNO_OTLP_HEADERS",
          "title": "Headers Env",
          "type": "string"
        },
        "log_content": {
          "default": false,
          "title": "Log Content",
          "type": "boolean"
        }
      },
      "title": "TelemetryOtlpBlock",
      "type": "object"
    },
    "TestBlock": {
      "description": "Bounds for one suite run under ``fno doctor test``.",
      "properties": {
        "max_net_new": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Net New"
        },
        "timeout_seconds": {
          "default": 1800,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "TestBlock",
      "type": "object"
    },
    "ThinkSpawnBlock": {
      "description": "Context-carrying /think spawn settings (nested under 'config.think_spawn').\n\nThe opt-in for node : when enabled, the node-birth path (``fno backlog\nidea``) OFFERS a context-carrying ``/think`` thread for a generated organic\nnode (a birth trigger never auto-spawns -), handing it the *resolved*\norigin transcript pointer (not a paraphrase) so a later pickup starts from\nground truth. A real spawn still happens for the explicit conversational\ncommand, an armed lifecycle trigger (``on_work_start``), or a\nconsented decompose fan-out.\n\nDefault ``False`` (Locked Decision 2): shipping this changes nothing until\nthe operator arms it; an absent key reads as off. The fail-safe posture\nmirrors ``config.auto_continue``: a malformed block degrades to disabled\nrather than failing the whole settings load - false-enabled (a background\n``/think`` dispatched against the operator's intent) is the dangerous\ndirection. The enable + presence + spawn logic lives in\n``crates/fno-agents/src/think_dispatch.rs`` and ``backlog/birth.rs``.\n\n``max_per_run`` is the per-node-generation-run blast-radius cap (AC4-EDGE):\na bulk run exceeding it skips the remainder and logs the truncation.\n``idle_threshold_s`` is the discretionary activity-recency refinement\n(Claude's Discretion 1); ``0`` (default) disables it so the primary\nattended-vs-headless signal stands alone.\n\nActual context-think launches use the shared ``config.dispatch`` profile;\nthis block controls when to offer or launch them, not their harness or\nsubstrate.",
      "properties": {
        "attended": {
          "default": "offer",
          "title": "Attended",
          "type": "string"
        },
        "daily_cap": {
          "default": 20,
          "title": "Daily Cap",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "idle_threshold_s": {
          "default": 0,
          "title": "Idle Threshold S",
          "type": "integer"
        },
        "max_per_run": {
          "default": 5,
          "title": "Max Per Run",
          "type": "integer"
        },
        "on_decompose_wave0": {
          "default": false,
          "title": "On Decompose Wave0",
          "type": "boolean"
        },
        "on_work_start": {
          "default": false,
          "title": "On Work Start",
          "type": "boolean"
        },
        "substrate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substrate"
        }
      },
      "title": "ThinkSpawnBlock",
      "type": "object"
    },
    "UserBlock": {
      "description": "How the machine addresses the human (nested under ``config.user``).\n\n``name`` is a form of address, never an identity and never an authority.\nEmpty is the unset state; the native birth read (backlog/birth.rs\n``display_name``) falls back to ``git config user.name`` so a fresh\ninstall already says something better than a role noun.",
      "properties": {
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        }
      },
      "title": "UserBlock",
      "type": "object"
    },
    "WatchdogBlock": {
      "description": "The lane's settings. The per-key text an operator reads is\n`FIELD_META` in `registry.py`; a copy here would drift from it.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "mail_to": {
          "default": "",
          "title": "Mail To",
          "type": "string"
        },
        "mode": {
          "default": "report",
          "enum": [
            "report",
            "wake",
            "handoff"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "WatchdogBlock",
      "type": "object"
    },
    "WordCapBlock": {
      "description": "Per-surface masked-word caps for style rule 7.\n\nOne number per surface that is read MID-TURN. The surface set itself lives\nin the style gate (crates/fno-agents/src/backlog/style_check.rs) and is not\nconfigurable: a project may move a number here, and may never cap a surface\nthe checker says is uncapped.\n\nBounds come from a validator, not from `Field(80, ge=1)`. A positional\ndefault plus a constraint makes mypy resolve this class's `default_factory`\nuse below as `Callable[[], Never]`, and `fno.config` is held to mypy strict.\n`MaintainBlock` above is the same shape for the same reason.",
      "properties": {
        "encounter": {
          "default": 80,
          "title": "Encounter",
          "type": "integer"
        },
        "mail": {
          "default": 80,
          "title": "Mail",
          "type": "integer"
        }
      },
      "title": "WordCapBlock",
      "type": "object"
    },
    "WorkBlock": {
      "description": "Workspace / project topology map (TOP-LEVEL ``work:`` in settings.yaml).\n\nStored at the top level (NOT under ``config:``), matching the live file and\nthe bash ``get_workspace`` reader (``scripts/lib/config.sh`` reads\n``.work.workspaces.*``). Load-bearing for project/cwd resolution in\n``fno backlog maintain`` / ``health``. The plan's \"config.work\" phrasing was\ncorrected to top-level to match ground truth and keep promotion non-breaking.",
      "properties": {
        "workspaces": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkspaceEntry"
          },
          "title": "Workspaces",
          "type": "object"
        }
      },
      "title": "WorkBlock",
      "type": "object"
    },
    "WorkspaceEntry": {
      "description": "One named workspace (work.workspaces.<slug>).",
      "properties": {
        "projects": {
          "items": {
            "$ref": "#/$defs/WorkspaceProjectEntry"
          },
          "title": "Projects",
          "type": "array"
        }
      },
      "title": "WorkspaceEntry",
      "type": "object"
    },
    "WorkspaceProjectEntry": {
      "description": "One project within a workspace (work.workspaces.<slug>.projects[]).\n\nField names match what the bash ``get_workspace`` reader and the\ncross-project pipeline expect; ``extra=\"ignore\"`` keeps any extra per-project\nkeys a user added.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "package_manager": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Manager"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "stack": {
          "items": {
            "type": "string"
          },
          "title": "Stack",
          "type": "array"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "worktree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worktree"
        }
      },
      "title": "WorkspaceProjectEntry",
      "type": "object"
    },
    "WorktreeBlock": {
      "description": "config.worktree.* - global worktree-isolation defaults.\n\n``extra=\"ignore\"`` keeps the DEPRECATED ``use_conductor_canonical`` key\n(read ad-hoc via read_config_flat elsewhere) valid here. ``policy`` is the\nglobal default (never|harness-native|external); a per-project entry's\n``worktree`` key overrides it. Validated at resolve time, not here.",
      "properties": {
        "auto_install": {
          "default": true,
          "title": "Auto Install",
          "type": "boolean"
        },
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        },
        "prune_done": {
          "default": "balanced",
          "title": "Prune Done",
          "type": "string"
        },
        "setup_command": {
          "default": "",
          "title": "Setup Command",
          "type": "string"
        },
        "skip_verification": {
          "default": false,
          "title": "Skip Verification",
          "type": "boolean"
        },
        "test_command": {
          "default": "",
          "title": "Test Command",
          "type": "string"
        }
      },
      "title": "WorktreeBlock",
      "type": "object"
    }
  },
  "description": "Root settings model. Config fields live at the TOP level (flat).\n\nHistorically every setting nested under a ``config:`` key; the file is now\nflat (``config.toml`` with top-level blocks). ``SettingsModel`` inherits\n``ConfigBlock`` so ``settings.review`` / ``settings.project`` resolve\ndirectly. The legacy ``config:``-wrapped shape still loads via the\n``_unwrap`` before-validator (so ``SettingsModel(config={...})`` and old\nYAML both work).",
  "properties": {
