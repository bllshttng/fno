      "type": "object"
    },
    "HealthMonitorBlock": {
      "description": "Backlog health monitoring (config.health_monitor).\n\nPromoted from the private ``health_monitor.py:DEFAULT_CONFIG`` so the model\nis the single source of truth (US1) and ``health_monitor.py`` can read\n``load_settings().health_monitor`` instead of re-loading the YAML (US2).\nSub-blocks use ``extra=\"ignore\"`` + fail-safe coercers so a malformed value\ndegrades to defaults rather than breaking ``load_settings()`` (Failure Modes).",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "history": {
          "$ref": "#/$defs/HealthHistoryBlock"
        },
        "notifications": {
          "$ref": "#/$defs/HealthNotificationsBlock"
        },
        "thresholds": {
          "$ref": "#/$defs/HealthThresholdsBlock"
        }
      },
      "title": "HealthMonitorBlock",
      "type": "object"
    },
    "HealthNotificationsBlock": {
      "description": "Backlog-health notification routing (config.health_monitor.notifications).",
      "properties": {
        "discord_channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discord Channel"
        },
        "surfaces": {
          "items": {
            "type": "string"
          },
          "title": "Surfaces",
          "type": "array"
        },
        "throttle_minutes": {
          "default": 60,
          "title": "Throttle Minutes",
          "type": "integer"
        },
        "webhook_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Webhook Url"
        }
      },
      "title": "HealthNotificationsBlock",
      "type": "object"
    },
    "HealthThresholdsBlock": {
      "description": "Backlog-health breach thresholds (config.health_monitor.thresholds).\n\nDefaults lifted verbatim from the former\n``health_monitor.py:DEFAULT_CONFIG[\"thresholds\"]`` (US2 converges that\nprivate loader onto this block).",
      "properties": {
        "collision_count": {
          "default": 3,
          "title": "Collision Count",
          "type": "integer"
        },
        "failure_prone_attempts": {
          "default": 2,
          "title": "Failure Prone Attempts",
          "type": "integer"
        },
        "idea_pile_depth": {
          "default": 25,
          "title": "Idea Pile Depth",
          "type": "integer"
        },
        "orphan_feature_rate": {
          "default": 1.0,
          "title": "Orphan Feature Rate",
          "type": "number"
        },
        "project_cwd_mismatch": {
          "default": 0,
          "title": "Project Cwd Mismatch",
          "type": "integer"
        },
        "stale_ready_days": {
          "default": 30,
          "title": "Stale Ready Days",
          "type": "integer"
        }
      },
      "title": "HealthThresholdsBlock",
      "type": "object"
    },
    "InboxBlock": {
      "description": "Cross-session mail delivery-honesty settings (nested under 'config.inbox').\n\n``unclaimed_ttl`` (seconds, default 1800/30m, locked) is the age\npast which a sent-but-unclaimed bus message is surfaced back to its\nsender. ``landed_abandon_ttl`` (seconds, default 21600/6h) is the age past\nwhich an outstanding message drops off that nag entirely and is never\ngrepped again. Both non-negative.",
      "properties": {
        "landed_abandon_ttl": {
          "default": 21600,
          "title": "Landed Abandon Ttl",
          "type": "integer"
        },
        "tool_boundary_ordinary": {
          "default": false,
          "title": "Tool Boundary Ordinary",
          "type": "boolean"
        },
        "unclaimed_ttl": {
          "default": 1800,
          "title": "Unclaimed Ttl",
          "type": "integer"
        }
      },
      "title": "InboxBlock",
      "type": "object"
    },
    "JoinBlock": {
      "description": "`fno backlog join` behavior (config.join.*).\n\n``sandbox`` is ONE switch over BOTH enforcement layers of the per-joiner\nwrite partition (the OS allowlist composed into the worker's --settings\nand the Edit/Write guard): partial enforcement that reads as enforcement\nis the failure mode the feature exists to prevent, so they are not\nseparately toggleable. Default off; a config error degrades toward off.",
      "properties": {
        "sandbox": {
          "default": false,
          "title": "Sandbox",
          "type": "boolean"
        }
      },
      "title": "JoinBlock",
      "type": "object"
    },
    "KeepGoingBlock": {
      "description": "Autonomous keep-going engine settings (nested under 'config.keep_going').\n\nThe opt-in for the autonomous keep-going engine : when enabled, the\nautonomous ``/fno:ship pr merged`` ritual classifies each surviving carve-out\nfollow-up and DISPATCHES the next unit of work (a ``/think``, a ``/target``,\nor just a filed node) instead of only closing the merged node. This is what\nkeeps the autonomous loop moving without a human in the seat.\n\nDefault ``False`` (same posture as ``config.auto_continue`` /\n``config.think_spawn``): shipping this changes nothing until the operator\narms it - false-enabled (background workers dispatched against the operator's\nintent) is the dangerous direction, so a malformed block fails safe to\ndisabled rather than breaking the whole settings load.\n\nThe firehose ceiling is NOT a knob here: it deliberately reuses\n``config.think_spawn.daily_cap`` (the same per-install per-day counter\n``fno do think dispatch`` bumps) so think + target dispatches share ONE budget -\na single ceiling on total autonomous fan-out per day. The classify + dispatch\nlogic lives in the native retro keep-going engine (crates/fno-agents/src/retro/keep_going.rs).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "KeepGoingBlock",
      "type": "object"
    },
    "LeadBlock": {
      "description": "The lead loop (config.lead). Field detail is in registry.py's Meta\ntext, surfaced by `fno config schema`.\n\nThe wake arm runs inside the fno-agents daemon, so a machine without the\ndaemon has no waker; ``wake_enabled`` does not change that.",
      "properties": {
        "autonomous_merge": {
          "default": false,
          "title": "Autonomous Merge",
          "type": "boolean"
        },
        "blocked_child_grace_minutes": {
          "default": 30,
          "title": "Blocked Child Grace Minutes",
          "type": "integer"
        },
        "checkin_interval": {
          "default": "55m",
          "title": "Checkin Interval",
          "type": "string"
        },
        "checkin_text": {
          "default": "lead check-in. Run fno agents org checkin: it gathers the check-in readings, prints them, diffs the last beat, and journals lead_checkin. Then act on the printout per the lead skill. When nothing changed and coverage is full, print 'no change' and stop. This beat is a heartbeat. ",
          "title": "Checkin Text",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "implementation_guard": {
          "default": "refuse",
          "title": "Implementation Guard",
          "type": "string"
        },
        "wake_backstop_seconds": {
          "default": 1800,
          "title": "Wake Backstop Seconds",
          "type": "integer"
        },
        "wake_ceiling": {
          "default": 32,
          "title": "Wake Ceiling",
          "type": "integer"
        },
        "wake_debounce_seconds": {
          "default": 900,
          "title": "Wake Debounce Seconds",
          "type": "integer"
        },
        "wake_enabled": {
          "default": false,
          "title": "Wake Enabled",
          "type": "boolean"
        },
        "write_roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Write Roots",
          "type": "array"
        }
      },
      "title": "LeadBlock",
      "type": "object"
    },
    "LoopEntry": {
      "description": "One named loop's level (``config.loops.<name>``).\n\n``report`` (observe only) is the safest default, so a malformed or\nunrecognized level fails safe to it rather than raising - a standing\nloop must never silently upgrade its own autonomy from a config typo.",
      "properties": {
        "budget_usd_per_run": {
          "default": 30.0,
          "title": "Budget Usd Per Run",
          "type": "number"
        },
        "level": {
          "default": "report",
          "enum": [
            "report",
            "assisted",
            "unattended"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "title": "LoopEntry",
      "type": "object"
    },
    "MaintainBlock": {
      "description": "`fno backlog maintain` settings (nested under 'config.backlog.maintain').",
      "properties": {
        "abandoned_do_row_hours": {
          "default": 24,
          "title": "Abandoned Do Row Hours",
          "type": "integer"
        },
        "budget_seconds": {
          "default": 300,
