        },
        "retire_grace_s": {
          "default": 900,
          "minimum": 0,
          "title": "Retire Grace S",
          "type": "integer"
        },
        "retire_interval_s": {
          "default": 300,
          "minimum": 0,
          "title": "Retire Interval S",
          "type": "integer"
        },
        "silence_deadline_seconds": {
          "default": 600,
          "title": "Silence Deadline Seconds",
          "type": "integer"
        },
        "single_flight_join_budget_seconds": {
          "default": 30,
          "title": "Single Flight Join Budget Seconds",
          "type": "integer"
        },
        "single_flight_ttl_seconds": {
          "default": 60,
          "title": "Single Flight Ttl Seconds",
          "type": "integer"
        },
        "state_reap": {
          "$ref": "#/$defs/StateReapBlock"
