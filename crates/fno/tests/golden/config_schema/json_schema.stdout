    "MuxBlock": {
      "description": "fno mux (terminal multiplexer) settings (nested under 'config.mux').\n\n``shell_integration`` controls whether the mux auto-injects the\nOSC 133 block-marker snippet into the shells it spawns, so command-block\ncapture works with zero user config and WITHOUT touching the user's global\nshell rc. The injection happens ONLY in mux-spawned pane shells (temp\n``ZDOTDIR`` / ``--rcfile``), never in ``~/.zshrc`` / ``~/.bashrc``. Consumed\nby the Rust mux via ``FNO_MUX_SHELL_INTEGRATION``; absent env reads as\n``mux-panes`` (the Rust default is on).\n\n``prefix`` and ``keys`` are the keyboard. The mux prefix shipped as Ctrl-b\nwith no way to move it, which collides with readline, vim and emacs for\nanyone who did not choose tmux's default on purpose. ``prefix`` takes a key\nspec (``C-a``, ``Ctrl-a``, ``^a``, or a bare printable character) and\n``keys`` maps a stable action id to the key that should run it, e.g.\n``keys.detach = \"D\"``. The action ids are the ones ``prefix+?`` lists; the\nRust client reads both straight from config.toml (the same split-brain as\n``attach_digest``, since the interactive attach path has no Python launcher)\nand refuses any rebind that is unparseable, names no action, lands on the\nstructural ``1``-``9`` tab range, or collides with another action, saying so\nin a notice rather than silently running the shipped default.\n\n``notify_on_blocked`` / ``notify_on_done`` are read by the Rust daemon straight\nfrom config.toml; modeling them here keeps them settable via ``fno config``.\n\nFields\n------\nshell_integration:\n    ``mux-panes`` (default): inject into mux-spawned pane shells only.\n    ``off``: never inject (the manual ``fno mux shell-init`` eval still\n    works). Any other value coerces to ``mux-panes`` - only ``off`` is off,\n    matching the Rust ``integration_disabled`` semantics.",
      "properties": {
        "attach_digest": {
          "default": true,
          "title": "Attach Digest",
          "type": "boolean"
        },
        "attach_digest_threshold_min": {
          "default": 10,
          "minimum": 1,
          "title": "Attach Digest Threshold Min",
          "type": "integer"
        },
        "board_scope": {
          "default": "repo",
          "title": "Board Scope",
          "type": "string"
        },
        "card_graph": {
          "default": "activity",
          "enum": [
            "activity",
            "context"
          ],
          "title": "Card Graph",
          "type": "string"
        },
        "hover_focus": {
          "default": true,
          "title": "Hover Focus",
          "type": "boolean"
        },
        "keys": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Keys",
          "type": "object"
        },
        "load_readout": {
          "default": "simple",
          "enum": [
            "simple",
            "detailed"
          ],
          "title": "Load Readout",
          "type": "string"
        },
        "notify_on_blocked": {
          "default": true,
          "title": "Notify On Blocked",
          "type": "boolean"
        },
        "notify_on_done": {
          "default": false,
          "title": "Notify On Done",
          "type": "boolean"
        },
        "open_with": {
          "default": "inmux",
          "enum": [
            "inmux",
            "obsidian",
            "system"
          ],
          "title": "Open With",
          "type": "string"
        },
        "paint_background": {
          "default": true,
          "title": "Paint Background",
          "type": "boolean"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        },
        "restore": {
          "$ref": "#/$defs/MuxRestoreBlock"
        },
        "shell_integration": {
          "default": "mux-panes",
          "title": "Shell Integration",
          "type": "string"
        },
        "status_row": {
          "default": true,
          "title": "Status Row",
          "type": "boolean"
        },
        "theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theme"
        },
        "viewer": {
          "default": "panel",
          "enum": [
            "panel",
            "modal"
          ],
          "title": "Viewer",
          "type": "string"
        },
        "wheel_lines": {
          "default": 1,
          "maximum": 50,
          "minimum": 1,
          "title": "Wheel Lines",
          "type": "integer"
        },
        "wheel_passthrough_rate": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Wheel Passthrough Rate",
          "type": "integer"
        }
      },
      "title": "MuxBlock",
      "type": "object"
    },
    "MuxRestoreBlock": {
