{
  "fields": [
    {
      "path": "state_dir",
      "type": "str",
      "default": "~/.fno/",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Root dir for global fno do state."
    },
    {
      "path": "plans_dir",
      "type": "str",
      "default": ".fno/plans/",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Where folder plans are written."
    },
    {
      "path": "plans_filename",
      "type": "str",
      "default": "%Y%m%d-{slug}-{node}.md",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Plan/design-doc filename template: strftime codes plus {slug} and {node} placeholders; must render to a bare *.md name."
    },
    {
      "path": "branch.prefix",
      "type": "str",
      "default": "fno",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Prefix for dispatched worktree branches: <prefix>/<slug>-<node>."
    },
    {
      "path": "obsidian.enabled",
      "type": "bool",
      "default": false,
      "tier": "always",
      "question": "Use an Obsidian vault for plans and design docs?",
      "default_source": "",
      "doc": "Whether this project uses an Obsidian vault for plans/docs."
    },
    {
      "path": "obsidian.vault",
      "type": "str (optional)",
      "default": null,
      "tier": "always",
      "question": "Obsidian vault area name?",
      "default_source": "auto-detect",
      "doc": "Vault area name (NOT a filesystem path)."
    },
    {
      "path": "project.id",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "repo-slug",
      "doc": "Project identifier."
    },
    {
      "path": "project.vision",
      "type": "str (optional)",
      "default": null,
      "tier": "always",
      "question": "One-line project vision (what is this and why)?",
      "default_source": "readme",
      "doc": "One-paragraph statement of what this codebase is and why."
    },
    {
      "path": "inbox.unclaimed_ttl",
      "type": "int",
      "default": 1800,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds past which a sent-but-unclaimed bus message is surfaced back to its sender (the turn-boundary nudge)."
    },
    {
      "path": "inbox.landed_abandon_ttl",
      "type": "int",
      "default": 21600,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds past which an outstanding sent message drops off the nag entirely and is never grepped again."
    },
    {
      "path": "inbox.tool_boundary_ordinary",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "true lands ordinary mail at the next tool call (Claude PreToolUse), so a worker busy in one long turn reads it without waiting for its next prompt. Default false: ordinary mail waits for the prompt boundary; control mail lands at the tool call either way."
    },
    {
      "path": "user.name",
      "type": "str",
      "default": "",
      "tier": "always",
      "question": "What should fno call you?",
      "default_source": "git-user-name",
      "doc": "What fno calls you. Empty falls back to `git config user.name`."
    },
    {
      "path": "sandbox.on_unavailable",
      "type": "typing.Literal['refuse', 'warn']",
      "default": "refuse",
      "tier": "advanced",
      "question": "If a sandbox backend is unavailable, refuse or warn and continue?",
      "default_source": "default",
      "doc": "When a headless harness has no confinement backend: refuse before spawn (default) or explicitly warn and continue unconfined."
    },
    {
      "path": "blueprint.max_prs_per_epic",
      "type": "int",
      "default": 4,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Hard ceiling on the PRs one plan or decomposed epic may open; an epic's max_children and --max-prs may only tighten it, and fno-agents wave check warns on a plan that declares more."
    },
    {
      "path": "blueprint.python_repair_added_lines",
      "type": "int",
      "default": 30,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Added lines a cli/src/fno Python change that does not shrink the tree may add under law d-a9cddc93 (default 30). The push-time tally in check-file-budget.sh passes a change whose Python tree net is negative (a port that deletes more than it adds); this budget binds a change whose net is zero or positive. Also read by the plan gate in validate-plan.sh."
    },
    {
      "path": "plan.default_diff_budget",
      "type": "int",
      "default": 300,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Added lines a target session's branch may carry before the commit-time diff-budget guard (hooks/diff-budget-commit.sh) names the overrun; the bound plan's frontmatter diff_budget key overrides it per plan (default 300; 0 is off)."
    },
    {
      "path": "backlog.maintain.staleness_days",
      "type": "int",
      "default": 30,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Age (days) before an idea is flagged stale."
    },
    {
      "path": "backlog.maintain.max_failed_attempts",
      "type": "int",
      "default": 3,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Consecutive failures before a node auto-defers."
    },
    {
      "path": "backlog.maintain.abandoned_do_row_hours",
      "type": "int",
      "default": 24,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Idle hours before `maintain --apply` and `requeue` settle an open do row with no live claim and no reachable worker on its node."
    },
    {
      "path": "backlog.maintain.budget_seconds",
      "type": "int",
      "default": 300,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Wall-clock budget (seconds) for one `fno backlog maintain` pass; a short run exits 4 with a partial receipt naming the leg it stopped in."
    },
    {
      "path": "backlog.maintain.validity_days",
      "type": "int",
      "default": 60,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Age (days) before a stale idea enters the validity sweep."
    },
    {
      "path": "backlog.maintain.validity_batch_size",
      "type": "int",
      "default": 25,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Oldest-first validity-sweep batch size (clamped to 100)."
    },
    {
      "path": "backlog.id_prefix",
      "type": "str (optional)",
      "default": null,
      "tier": "always",
      "question": "Backlog node-ID prefix?",
      "default_source": "repo-slug",
      "doc": "Prefix for minted node IDs (<=7 chars; not cv-/fu-/tgt-)."
    },
    {
      "path": "backlog.id_hex_width",
      "type": "int",
      "default": 8,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Hex width of minted node IDs (4-8)."
    },
    {
      "path": "backlog.staleness_days",
      "type": "int",
      "default": 21,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Age (days) before an unmoved ready node is quarantined from selection."
    },
    {
      "path": "backlog.epic_max_open_children",
      "type": "int (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Most open children an epic may hold. A write that would parent one more open child under a full epic is refused and names the new-epic command. Unset means no cap. The graph store reads it from the config.toml beside graph.json, the global config on a default install."
    },
    {
      "path": "backlog.max_open_ideas",
      "type": "int",
      "default": 25,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Most unplanned, machine-filed ideas one nearest-epic or project scope may hold (default 25; 0 is off). Operator asks are never capped. The graph store reads it from the config.toml beside graph.json."
    },
    {
      "path": "backlog.render_targets",
      "type": "list[RenderTargetConfig]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Auto-rendered boards (GLOBAL config file only): the daemon re-renders each {path, scope, projection=local|backlog|roadmap} target after a graph change; local (the default) writes the board page, backlog and roadmap warn-skip. Never use the state root. See [A local HTML file](backlog-usage.md#a-local-html-file)."
    },
    {
      "path": "backlog.page_reload_s",
      "type": "int",
      "default": 60,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Seconds an open local board, fleet.html or lead.html tab waits, visible and untouched, before it reloads itself (default 60; 0 is off)."
    },
    {
      "path": "batch.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Coalesce same-domain nodes into one batch PR (opt-in)."
    },
    {
      "path": "batch.max_nodes",
      "type": "int",
      "default": 3,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Nodes per batch before it closes (default 3)."
    },
    {
      "path": "batch.max_loc",
      "type": "int (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Optional cumulative-diff LOC ceiling for a batch (off by default)."
    },
    {
      "path": "post_merge.parking_lot_path",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Per-repo vault parking-lot path for the post-merge ritual (repo-relative)."
    },
    {
      "path": "post_merge.maintainer_marker",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Discriminator tag for maintainer-only post-merge items (e.g. '#maintainer'). Default empty: omit the tag entirely so a fresh install ships no one's initials. Honored by both the post-merge ritual and the capture parser; set per-repo only when the destination is a shared vault."
    },
    {
      "path": "post_merge.enabled",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Whether the post-merge ritual runs."
    },
    {
      "path": "post_merge.sync_command",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Canonical-sync incantation run via `bash -lc` after a merge (e.g. `git fetch origin main && git merge --ff-only origin/main && fno doctor update && fno agents session restart`). Unset = off."
    },
    {
      "path": "post_merge.sync_paths",
      "type": "list[str]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Repo-relative fnmatch globs gating the canonical sync (empty = always run; e.g. `[\"cli/**\", \"crates/**\"]` skips a docs-only merge)."
    },
    {
      "path": "post_merge.auto_run",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Let the pr-watch daemon (the sole merge detector) run `fno do pr ritual <pr> --autonomous` for a newly-merged PR (opt-in; default off). Reconcile no longer dispatches a ritual."
    },
    {
      "path": "post_merge.catchup_window_days",
      "type": "int",
      "default": 3,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How far back the canonical-sync catch-up sweep looks for merges with no sync marker (default 3 days). Bounds the sweep so a fresh clone never re-syncs all history."
    },
    {
      "path": "post_merge.sync_stale_hours",
      "type": "int",
      "default": 24,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How long the newest merge may sit unsynced before `fno doctor` reports the canonical checkout stale (default 24h)."
    },
    {
      "path": "post_merge.model",
      "type": "str",
      "default": "claude-opus-5",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Model for post-merge ritual workers (default claude-opus-5). Routing wins when a secondary provider is keyed."
    },
    {
      "path": "telemetry.claude_otel",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Bind the daemon's local OTLP receiver for Claude Code usage (default on)."
    },
    {
      "path": "telemetry.otlp.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Export feed events to an OTLP collector (default off)."
    },
    {
      "path": "telemetry.otlp.endpoint",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "OTLP collector URL, http(s); `/v1/logs` is appended when absent."
    },
    {
      "path": "telemetry.otlp.headers_env",
      "type": "str",
      "default": "FNO_OTLP_HEADERS",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Env var holding the export auth headers as `name=value,...`."
    },
    {
      "path": "telemetry.otlp.log_content",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Export event titles as log text (default off: only the event kind)."
    },
    {
      "path": "attention.enabled",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Kill switch for the attention arm (question pages and sinks; default on)."
    },
    {
      "path": "attention.sinks",
      "type": "list[dict[str, Any]]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Push sinks for open questions: a list of tables with name, type (ntfy or webhook), url, topic, token_env, answer_base_url and body (title-only or full)."
    },
    {
      "path": "research.output_dir",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Landing dir for the `fno do research` doc deliverable (brief + sources sidecar); vault area, not repo-relative. Unset => ship fails loud (never guesses)."
    },
    {
      "path": "review.posture",
      "type": "str (optional)",
      "default": null,
      "tier": "always",
      "question": "How much review must a code PR have before it can merge? (default: self_review)",
      "default_source": "",
      "doc": "How much review a code PR must have before it can merge, as one rung of a nine-step ladder (no_review | tests_pass | self_review | independent_review | github_review | peer_review | self_and_github | self_and_peer | self_github_and_peer). Default self_review: one real final-head review, author context allowed. Auto-merge (config grants, env grants, finalize, GitHub-native arming) refuses below self_review and names the remedy. Unset infers one visible posture from the legacy settings and prints the exact `fno config set review.posture <rung>` command that makes it permanent."
    },
    {
      "path": "review.github_apps",
      "type": "list[str] (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "GitHub App bot logins that must have reviewed before the ship gate goes green (the GATE). Legacy alias: required_bots."
    },
    {
      "path": "review.peers",
      "type": "list[Any]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Harness peers run locally and gate on a head-pinned clean verdict. Scalar or {provider, model} entries need no second GitHub account; adding identity opts into legacy posted-review mode."
    },
    {
      "path": "review.peer_identity",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Optional legacy carrier: the distinct machine-account login peers post their review under (must not be the author account)."
    },
    {
      "path": "review.peer_token_env",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Optional legacy carrier: env var holding the PAT for peer_identity used to post peer reviews to the PR."
    },
    {
      "path": "review.bot_identity",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "The distinct GitHub login the reviewer lane's bot-review mirror posts under (must not be the PR author: GitHub silently demotes an author's approving review to COMMENTED). Unset skips the bot-review leg of publish-review entirely, before any network call."
    },
    {
      "path": "review.bot_token_env",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Optional env var holding the PAT for review.bot_identity, used to post the verdict to the PR as the bot."
    },
    {
      "path": "review.optional_apps",
      "type": "list[str] (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Reviewer logins honored-if-present but NOT required: the gate never waits for them (kills the App-bot usage-limit wedge), but a blocking finding from one still holds it. Also the escape for a required App you no longer want the gate to wait on: move its login here. UNSET resolves to the built-in default [chatgpt-codex-connector] on both readers (`fno do pr status` and the loop-check gate); an explicit [] is a real opt-out and wins over the default; a non-empty list EXTENDS the default (add a login) rather than replacing it, so a partial list never silently drops a built-in."
    },
    {
      "path": "review.nudge",
      "type": "dict[str, Any]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Per-App override for the bot-review nudge, as [review.nudge.<login>] tables with {review_handle, wait_minutes, ceiling, enabled}. A github_apps bot that reviews on MENTION not on push never reviews unless something posts its trigger; the loop-check stop gate posts review_handle (default from the built-in profile), waits wait_minutes (default 15), and after ceiling (default 3) unanswered nudges gives up rather than idling to the budget ceiling. enabled=false opts a repo back into plain block-and-wait. Ships populated for chatgpt-codex-connector, which wears three distinct names for one bot: match the review-author login chatgpt-codex-connector, trigger a fresh review with '@codex review', and address an in-thread reply to '@chatgpt-codex-connector'."
    },
    {
      "path": "review.reviewer_registry",
      "type": "dict[str, ReviewerDescriptor]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Project-registered reviewers, as [review.reviewer_registry.<name>] tables with the built-in descriptor fields (kind, requires, invocation, asserts). Unioned with footnote's own reviewers so config.review.reviewers may name one; built-ins win a name collision. asserts=invocation is the honest rung for a harness skill: it proves the skill ran at the reviewed commit and claims nothing about its verdict."
    },
    {
      "path": "review.reviewers",
      "type": "list[str]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Local-attestation reviewers (code-review | peer | declare, or a name from review.reviewer_registry) that produce no GitHub review: loop-check accepts a head-pinned review_attestation event as gate evidence. Lets a solo/claude-only harness express a real gate with no App bot. sigma is retired; naming it here refuses at init with `/fno:review` named as the replacement."
    },
    {
      "path": "review.self_review_required",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "When true (default), a code payload floors the harness-resolved self-review reviewer (claude /code-review, codex /review) onto the required set on a stock install, so a /target that ships code is held for a head-pinned attestation instead of asking an epic leader. Set false only under a live claim; the opt-out lapses after review.optout_ttl_minutes and disarms unattended auto-merge while held."
    },
    {
      "path": "review.require_corroboration",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "DEPRECATED, ignored since 2026-09-05: origin never gates. Setting it changes nothing; the key is kept so an existing config still loads. Every review counts as a round, whoever or whatever session produced it."
    },
    {
      "path": "review.github_approval_satisfies",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "When true (default), a non-author human GitHub APPROVED review satisfies coverage on its own - the one producer a stranger's GitHub project emits with no footnote machinery. The approver's login must differ from the PR author's (GitHub refuses an author's approval server-side; the gate asserts it, and an unreadable PR author excludes fail-closed). Set false to keep today's recorded-but-never-counted behavior. Limit: GitHub's refusal is per identity, not per human - a second account with its own token can still self-approve."
    },
    {
      "path": "review.max_rounds",
      "type": "int",
      "default": 2,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "The maximum number of review rounds (default 2): a PR gets AT MOST this many reviews and never waits for a round to come back clean. Two means two, counted across the whole life of the PR. A round is one reviewed HEAD. Two verdicts at one unchanged head are one round. A cap whose size depends on how a reviewer batches its output is not a cap. A pass is a round like any verdict: it still satisfies coverage, but it refunds nothing. At this many rounds the review phase is complete: the PR merges on green CI and open findings stay in the PR conversation - nothing is filed to the backlog and no finding class holds the PR past its own budget. CI failures, lint failures and rebases are not rounds. One review stays the floor, so an unreviewed PR is still uncovered. Validated at parse: at least 1."
    },
    {
      "path": "review.carry_interdiff_lines",
      "type": "int",
      "default": 100,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How many interdiff lines a rebase or fix commit may add while a verdict from the older head still counts as a review of the new one (default 100, the threshold of the attestation law d-608344c1). The measure is the multiset symmetric difference of the two PR-code patches against the base, never a direct head-to-head diff, so base movement contributes nothing. UNDER the bound carries; at or over it, or with an unreadable patch on either side, the verdict is stale and a fresh round is owed. 0 disables the arm."
    },
    {
      "path": "review.invocation_ttl_minutes",
      "type": "int",
      "default": 15,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How long after a review dispatch (a sent review_invocation row) with no answering attestation the settle sweep declares the attempt lost and emits one lost attestation row for it (default 15), so the gate reads a named refusal instead of waiting on silence. The doctor report runs the sweep; it is idempotent, so re-running adds nothing."
    },
    {
      "path": "review.nonblocking_categories",
      "type": "list[str] (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Categories a finding may carry and still be non-blocking when its verdict is not CONFIRMED (default: altitude, conventions, docs, efficiency, formatting, naming, nit, reuse, simplification, style, test-coverage, typo). A configured list EXTENDS that default rather than replacing it, so naming one category cannot silently narrow the gate. A CONFIRMED verdict blocks whatever the category says, and a finding missing a required field blocks too. The gate re-derives blocking from this list itself and never reads the producer's own blocking count."
    },
    {
      "path": "review.hold_ttl_minutes",
      "type": "int",
      "default": 90,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How long a registered review hold blocks a merge before it ages out (default 90). A review that starts registers review:branch:<branch>; fno do pr status and fno do pr merge refuse while it is live, so a merge cannot land on the pre-review code. A wedge bound, not an estimate: an expired hold clears with a receipt rather than holding the lane forever."
    },
    {
      "path": "review.optout_ttl_minutes",
      "type": "int",
      "default": 60,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How long a merge-gating opt-out claim remains live (default 60 minutes, maximum 24 hours). The claim is global, expires automatically, and disarms unattended auto-merge while held."
    },
    {
      "path": "review.external_reviewers",
      "type": "list[str]",
      "default": [],
      "tier": "always",
      "question": "Which external reviewer(s) should review your PRs (gemini/codex/none)?",
      "default_source": "",
      "doc": "Which AI reviewers /pr requests a review from (the INVOCATION list)."
    },
    {
      "path": "review.cross_model.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Enable cross-model (codex/gemini) second-opinion review."
    },
    {
      "path": "style.word_cap.mail",
      "type": "int",
      "default": 80,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Masked-word cap for style rule 7 on a mail body (default 80). The refusal names the number enforced here, not the built-in."
    },
    {
      "path": "style.word_cap.encounter",
      "type": "int",
      "default": 80,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Masked-word cap for the evidence on a `fno backlog encounter` vote (default 80). Over-length evidence is refused, never truncated."
    },
    {
      "path": "preflight.required",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Require a full local preflight receipt before opening a PR. Default false: CI is the merge gate and preflight is an opt-in rehearsal."
    },
    {
      "path": "approvals.authorized_principals",
      "type": "dict[str, list[str]]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Effect class -> principal ids allowed to approve it; the key `*` matches every class. Absent or empty means nobody may approve, so a fresh install can inspect pending approvals but cannot decide one. Financial, signature, employment, and destructive classes stay denied regardless of what is listed here."
    },
    {
      "path": "context.artifacts",
      "type": "dict[str, ArtifactConfig]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Project-supplied context artifacts: {identifier: {path, sensitivity}}. A role's context selector names an identifier resolved here (default sensitivity internal), so a pack installed in a second project is reviewed against that project's facts, not the first's. An unconfigured identifier blocks resolution with MISSING_CONTEXT."
    },
    {
      "path": "done_probes",
      "type": "list[str]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Repo-wide ship-gate probes: shell commands loop-check runs (60s each, cap 3 per source) before it will grant DonePRGreen, alongside any a plan declares. Both lists must pass; a plan can add probes and can never silence these. A probe is an OBSERVATION - one that mutates the repo races the session's own edits, and its only backstops are the timeout and the block reason."
    },
    {
      "path": "target.handoff.enabled",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Enable explicit target capability escalation."
    },
    {
      "path": "target.handoff.lead_used_pct_trigger",
      "type": "int",
      "default": 40,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Context-used %% that triggers an earlier lead compact nudge."
    },
    {
      "path": "target.defaults.max_iterations",
      "type": "int",
      "default": 40,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Session-input default: max pipeline iterations."
    },
    {
      "path": "guards.preset",
      "type": "typing.Literal['strict', 'standard', 'off']",
      "default": "standard",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Guardrail preset: strict (every gatable guard), standard (default: the two destructive-write guards stay on), or off. Read in Rust by guard_enabled; FNO_GUARD_PRESET wins over this key. Default standard."
    },
    {
      "path": "agents.single_flight_ttl_seconds",
      "type": "int",
      "default": 60,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds a single-flight answer counts as fresh (default 60, one liveness cadence). Callers arriving inside the window read one child's stdout instead of each spawning their own; the latch is keyed on the normalized argv, so two `do pr wait` calls for different PRs stay two flights."
    },
    {
      "path": "agents.single_flight_join_budget_seconds",
      "type": "int",
      "default": 30,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds a later caller waits for the in-flight holder's answer before running its own (default 30). Set over the 23.2 s worst-measured roster read: load is when the latch has to hold. An exhausted budget spawns and says so, because a latch that can wedge a caller is worse than the fan-out it prevents."
    },
    {
      "path": "agents.orphan_reap_after_seconds",
      "type": "int",
      "default": 5400,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Age at which an fno child that init inherited is reaped (default 5400). Three times `do pr wait --timeout 30m`, the longest detached child allowed to be running. The sweep also needs parent pid 1 and a pid no registry row names live."
    },
    {
      "path": "agents.a2a.auto",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Allow agents to auto-open agent-to-agent threads."
    },
    {
      "path": "agents.a2a.turn_ceiling",
      "type": "int",
      "default": 6,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Max turns in an agent-to-agent thread."
    },
    {
      "path": "agents.defaults.provider",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default HARNESS for bare `fno agents spawn` / `/agent spawn` (claude/codex/gemini/agy/opencode). The key NAME says provider but the values are harness values and an explicit -H flag wins; the vendor axis in config is agents.defaults.route (-P/--provider as a flag). Empty = unset (harness inference then claude). Validated at the spawn seam."
    },
    {
      "path": "agents.defaults.model",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default model for bare spawns, forwarded as --model but provider-scoped: an unbound model (no agents.defaults.provider) is scoped to the builtin default provider (claude), NOT the ambient harness, so a spawn resolving to a different provider (e.g. a codex-ambient session, or an explicit -H codex) leaves the model to that harness rather than forcing an incompatible one that 400s after the round-trip. Bind agents.defaults.provider (or set a per-provider model) to apply a model under a non-claude harness. An explicit -m flag always wins; empty = unset (provider default). Passthrough (provider CLIs own model names)."
    },
    {
      "path": "agents.defaults.effort",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default reasoning effort for bare spawns (minimal|low|medium|high|xhigh|max); an explicit --effort wins, empty = unset. Config-sourced effort degrades open on providers with no effort surface (gemini/agy)."
    },
    {
      "path": "agents.defaults.substrate",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default substrate for bare spawns (pane|thread|headless). An explicit substrate wins, empty = unset (per-provider default). Config-sourced value degrades open with a warning if incompatible with the resolved provider (e.g. thread needs the harness's journey-proven lane, claude only today)."
    },
    {
      "path": "agents.defaults.permission_mode",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default --permission-mode for bare spawns; an explicit flag wins, empty = unset. Config-sourced value degrades open with a warning if the resolved provider cannot map it (an explicit --permission-mode stays fail-closed)."
    },
    {
      "path": "agents.defaults.route",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default per-spawn route as vendor/model (e.g. zai/glm-5.3[1m]) for bare spawns, forwarded as --route. Fails closed on an unknown vendor or a missing key rather than silently billing the primary. Sits BESIDE the legacy provider field (which means harness, -H): route is position-carried (vendor/model) and so reaches the vendor axis provider could not. A config route owns the model, so a config model is not injected alongside it; an explicit --route wins, empty = unset."
    },
    {
      "path": "agents.defaults.account",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default claude account pin for bare spawns, forwarded as --account; an explicit --account wins, empty = unset."
    },
    {
      "path": "agents.defaults.harness",
      "type": "dict[str, HarnessOverlayBlock]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Per-harness answers under the spawn defaults, keyed by harness name: each entry may set permission_mode, effort, substrate, or an opaque args list appended behind a -- passthrough fence (the harness's own bundle, e.g. codex --profile <name>). The scalar fields on agents.defaults are the base that works for most; an entry here re-answers one harness whose flag vocabulary differs. Precedence: explicit flag > lane > profiles.<command>.harness.<h> > profiles.<command> > agents.defaults.harness.<h> > agents.defaults. provider/model/route/account are refused here (lane fields, never per-harness answers); an unknown harness name refuses at the spawn seam."
    },
    {
      "path": "agents.profiles",
      "type": "dict[str, SpawnProfileBlock]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Per-command spawn-defaults overlay keyed by the seed's leading slash-command. A profile may set scalar fields or a strict ordered lanes list: each lane is either the name of a [[routing.models]] row (harness, model, effort, route, account) or an inline table {provider,model,effort,substrate,permission_mode,route,account,pane_group,args}. Lanes are walked in declared order (the list is the rank), each lane's capacity read per its account, and the first lane that passes is the spawn's coordinate. by_difficulty optionally keys low|medium|high overlays that replace lanes and the policy fields; omitted fields inherit the base slot, and the effective difficulty comes from the dispatched node, rounding up to high. on_exhausted declares the all-lanes-skipped terminal: refuse (default; the spawn stops), degrade (the profile scalars answer), or queue (a typed capacity refusal, exit 78). on_low governs a low-capacity observation: allow, prefer_healthy (default; demote low behind healthy lanes), or skip. on_unknown governs stale, absent or unproven observations: allow (default) or skip. A lane named on the command line or FNO_SPAWN_GATE=0 degrades whatever on_exhausted says. Malformed lanes, overlays and unknown row names refuse at the spawn seam rather than billing an unintended vendor. A profile may also carry a harness table (agents.profiles.<command>.harness.<h>) whose entries re-answer permission_mode, effort, substrate or args for ONE harness; it sits between the lane rung and the profile scalars, and the same lane-field refusal applies. agents.profiles.blueprint.max_live (default 5) and agents.profiles.blueprint.max_live_per_territory (default 1) cap live blueprint threads; the spawn gate refuses past either and teaches the subagent path."
    },
    {
      "path": "agents.fallback",
      "type": "dict[str, Any]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Ordered fallback chain per node size, consulted ONLY when a provider refuses and the account queue cannot answer (agents.fallback.<S|M|L|default> = a list of {harness,model,effort,substrate,permission_mode,route,account} links). The operator rule 'simple work to a claude sonnet bg thread, complex work to codex' written where a daemon can read it. Give every size more than one link: a claude weekly cap and a z.ai five-hour cap are different meters with different periods, and either can be the one that is down. A link whose own provider reads EXHAUSTED with an unexpired reset is SKIPPED; UNKNOWN is not exhausted and stays eligible. An all-exhausted chain returns empty rather than link zero, because routing into a known-capped provider is worse than holding. Unlike agents.profiles this block REFUSES a malformed value rather than degrading open: degrading open on the failover path spawns a worker at an unintended vendor and bills it."
    },
    {
      "path": "agents.silence_deadline_seconds",
      "type": "int",
      "default": 600,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds of transcript silence after which `fno agents fleet sweep` reports a worker as silent (default 600). A REPORT and never an action: no stop, no spawn, no claim mutation. A worker whose transcript age is unknowable emits nothing at all, because absence of evidence must not become a finding."
    },
    {
      "path": "agents.auto_register_sessions",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Auto-join every hand-started session to the roster at SessionStart (default false: a session joins at its first fno skill or command, or via /fno-me). Spawned workers register regardless."
    },
    {
      "path": "agents.happy_routed_panes",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Launch routed claude panes through happy for remote monitoring; default false and pane-only."
    },
    {
      "path": "agents.first_check_minutes",
      "type": "int",
      "default": 10,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Minutes after spawn before the daemon checks worker progress (default 10, range 1 to 60). With no progress it mails the spawning lead and checks once more after the same interval."
    },
    {
      "path": "agents.retire_grace_s",
      "type": "int",
      "default": 900,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds a worker's transcript must be quiet past, once every node its session is named on is done, before the daemon's retirement sweep drops its registry row (default 900). The receipt and the node's sessions[] row keep the resume handle. A legacy recovery.retire_grace_s still parses and lifts onto this key with a warning."
    },
    {
      "path": "agents.retire_interval_s",
      "type": "int",
      "default": 300,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds between runs of the daemon's retirement sweep (default 300, a third of the retire grace). The Rust resolver clamps this under a third of agents.retire_grace_s: the interval must be a fraction of the grace, never a multiple, so an eligible row never waits past the grace window it retires inside. Unset, unparseable, or below the 5s daemon tick resolves to the default. The `retire` row in `fno agents session status` carries the value the loop enforces."
    },
    {
      "path": "agents.hold_escalate_after_s",
      "type": "int",
      "default": 5400,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Seconds a reaper hold (sources disagree, transcript unresolved, open do row, needs live stop, stop refused) must sit past before the reap report names its release command and the stale-escalate arm asks the operator (default 5400). A hold whose age cannot be measured never escalates."
    },
    {
      "path": "agents.reap_receipts.retain_days",
      "type": "int",
      "default": 7,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Days a reap receipt (the resume handle for a reaped row) stays before the GC sweep expires it (default 7). A receipt whose reaped_at cannot be read is kept and named, never deleted on a failed read."
    },
    {
      "path": "agents.reap.roster_scope",
      "type": "str",
      "default": "provenanced",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Which rows the roster sweep may retire: off retires nothing and reads roster=off on the tick, provenanced (the default) only rows whose provenance resolves to fno and whose work is done, all widens to rows fno itself spawned (sessions or registry provenance) with open work. The daemon's retire arm runs the sweep after the registry sweep, so off stops the scheduled pass; the manual command keeps its own default. An unowned session retires only on an ownership marker: a sessions[] row fno wrote, or a reap receipt an earlier retirement staged for the same session. A present value that cannot be honored degrades in place to the default and is named by fno config doctor."
    },
    {
      "path": "agents.state_reap.enabled",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Run age-based cleanup for expendable lock, expired-claim, and PR-status cache files (default true)."
    },
    {
      "path": "agents.state_reap.locks_retain_days",
      "type": "int",
      "default": 7,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Days to retain inactive lock files before state cleanup removes them (default 7)."
    },
    {
      "path": "agents.state_reap.expired_claims_retain_days",
      "type": "int",
      "default": 30,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Days to retain claims moved into the expired-claims graveyard (default 30)."
    },
    {
      "path": "agents.state_reap.pr_status_cache_retain_days",
      "type": "int",
      "default": 14,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Days to retain expendable PR-status cache files (default 14)."
    },
    {
      "path": "agents.claude.beat",
      "type": "str",
      "default": "auto",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "What keeps a claude lead waking between events: auto (default) reads the harness capability row (today loop: the lead arms /loop beside the daemon wake), or daemon, loop, goal, schedule to override. `fno-agents harness-beat` prints the resolved beat."
    },
    {
      "path": "agents.codex.beat",
      "type": "str",
      "default": "auto",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "What keeps a codex lead waking between events: auto (default) reads the harness capability row (today goal: the provider goal), or daemon, loop, goal, schedule to override. `fno-agents harness-beat` prints the resolved beat."
    },
    {
      "path": "agents.codex.headless_yolo",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Use full-yolo (drop sandbox) for headless codex workers."
    },
    {
      "path": "agents.gemini.headless_yolo",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Use full-yolo (drop sandbox) for headless gemini workers."
    },
    {
      "path": "agents.naming.worker",
      "type": "str",
      "default": "t-{slug}",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Name template for a worker on a node: fno agents spawn, a bare claude --bg with no name, and a row still named by its short id. Tokens: {slug} (first words of the node slug), {node} (node id), {skill} (the seed's command, e.g. target), {random} (four hex digits). A token with no value for the worker falls back to the next name source."
    },
    {
      "path": "agents.max_live",
      "type": "int",
      "default": 3,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Backstop cap on concurrent live worker processes (fno registry + claude roster union); spawn queues at cap (default 3). Sized from RAM, because every live row holds RAM whether or not it works: floor((RAM_GB - 4 GB OS reserve - your desktop apps) / 1 GB per worker). The 1 GB planning figure is generous on purpose (a build or a test suite bursts past the measured 430 MB a quiet worker holds); the CPU axis (max_fleet_cpu_share) binds first on any machine with real headroom, so raise this instead of tuning it."
    },
    {
      "path": "agents.max_live_per_territory",
      "type": "int",
      "default": 4,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Per-territory team cap: the max live workers whose node is contained in one role scope, enforced in the spawn gate beside agents.max_live (the machine ceiling, which stays independent and authoritative). Rows that work no node (leads, blueprinters, ad-hoc panes) never count. Unknown territory attribution refuses; other-territory headroom is untouched (default 4)."
    },
    {
      "path": "agents.provider_limits",
      "type": "dict[str, ProviderBudget]",
      "default": {
        "zai": {
          "lanes": 5,
          "subagents": 1
        }
      },
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Per-provider budget record keyed by model provider: `lanes` is the immediate-refusal cap on concurrent live workers. A claude worker with an open operator question and a transcript quiet for 900 s or more is left out of that count until it writes again or its question closes; the lanes probe lists it under `parked`. `subagents` is the in-session fan-out width review route resolution reads (1 means a panel is never dispatched there). A bare integer is still legal and reads as `lanes`. Unlisted providers are uncapped in both dimensions; the built-in zai budget is lanes 5, subagents 1, because that account is shared. Renamed from `agents.max_lanes` so no two leaves share that name with `parallel.max_lanes`; the legacy spelling still parses with one deprecation line."
    },
    {
      "path": "agents.pane_group_max",
      "type": "int",
      "default": 4,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Maximum panes placed in one named pane_group tab before a spawn creates the next numbered sibling tab (default 4)."
    },
    {
      "path": "agents.min_free_gb",
      "type": "float",
      "default": 4.0,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Available-RAM floor in GB for spawn preflight; spawn refuses below it (<= 0 disables; default 4). Set it to what the OS needs to stay out of swap: 2 on an 8 GB box, 3 on 16 GB, 4 above."
    },
    {
      "path": "agents.max_swap_pct",
      "type": "float",
      "default": 90.0,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Swap-pressure ceiling in percent used for spawn preflight, checked beside agents.min_free_gb on EVERY spawn; spawn refuses when swap used is at or above the cap AND the machine swaps in at 1 MiB/s or more over a 1 s sample (<= 0 disables; default 90). macOS keeps swap allocated after pressure ends, so allocation alone refused every spawn with 69 percent of RAM free and no paging. The receipt names the failing term; raising min_free_gb does not fix a swap refusal."
    },
    {
      "path": "agents.max_load_per_cpu",
      "type": "float",
      "default": 8.0,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "DEPRECATED and ignored since 2026-09-09: admission decides on the fleet's CPU share (agents.max_fleet_cpu_share) on every spawn, never on a load trigger - the 1-minute load moved 101 points in three minutes with no change in real work. The key parses for one release and prints one deprecation line when set; delete it."
    },
    {
      "path": "agents.max_fleet_cpu_share",
      "type": "float",
      "default": 0.5,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Share of CPU capacity the fleet may hold, checked on EVERY spawn (default 0.5). An attribution gap widens the share to an interval bounded above by the whole machine's measured CPU: over by its own attributed work the gate holds and re-samples; the ceiling inside the interval refuses and names both bounds plus the gap; above the interval the gate admits and says the reading was an upper bound. Leave 0.5 unless the box is dedicated, then 0.6."
    },
    {
      "path": "agents.worker_qos",
      "type": "str",
      "default": "utility",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Worker CPU/IO priority: utility (background QoS, default) or off."
    },
    {
      "path": "agents.footprint_sustained_cpu_cores",
      "type": "float (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Absolute override for the doctor footprint sustained-CPU threshold, in cores. Unset, the threshold derives from measured CPU capacity (a fraction per core) instead of an absolute constant that asked a 12-core machine's fleet to idle at 8%."
    },
    {
      "path": "process_admission.max_processes",
      "type": "int",
      "default": 400,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Maximum fno-attributed OS processes admitted by the native pre-spawn gate; counts processes, not agents or panes (default 400)."
    },
    {
      "path": "dispatch.harness",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "DEPRECATED: the stage table (config.agents.profiles.<command>.provider) is the home for the harness axis; this key reads as the fallback rung beneath it for one release. Migrate with `fno config set agents.profiles.target.provider <harness>`. Formerly the configured harness for autonomous dispatch."
    },
    {
      "path": "dispatch.substrate",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Default dispatch substrate (thread|headless|pane). Empty = per-harness default (claude=thread, else headless; a harness's thread bit must be journey-proven)."
    },
    {
      "path": "dispatch.command",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Dispatch command template with a single {id}. Empty = '/target --no-merge {id}'. Written in canonical claude slash syntax and normalized per-harness at resolve. A leading /command becomes $fno:command on codex and /fno:command on opencode. The deprecated gemini is refused. A non-slash template passes through literally."
    },
    {
      "path": "dispatch.command_registry",
      "type": "dict[str, DispatchCommandDescriptor]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Dispatch commands from outside fno, as [dispatch.command_registry.<name>] tables with the descriptor fields (invocation, invocations, requires, takes_node_id, asserts, session_phase). Unioned with the allowed_commands allowlist at resolve; a key naming an allowlisted command is dropped, so a project cannot redefine a shipped one. invocation is the worker's exact spelling and is rendered verbatim (never fno-namespaced); invocations maps harness to spelling and doubles as the harness allowlist, so a dispatch to any other harness refuses. requires=skill probes the harness skill roots at resolve and refuses naming them; asserts records what a completion proves (pr | doc | invocation); session_phase names the sessions-row phase stamped for the worker (a --node dispatch of a registry command without one is refused)."
    },
    {
      "path": "dispatch.allowed_commands",
      "type": "list[str]",
      "default": [
        "/target",
        "/think",
        "/blueprint"
      ],
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Command allowlist a node's dispatch_command must match or the resolver refuses (default: /target, /think, /blueprint)."
    },
    {
      "path": "dispatch.auto_merge",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "DEPRECATED: reads as auto_merge.grant for one release ('dispatch' when true); migrate with `fno config set auto_merge.grant <none|dispatch>`. Formerly the per-project merge posture for autonomous dispatch."
    },
    {
      "path": "dispatch.on_exhaustion",
      "type": "str",
      "default": "defer",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "On provider exhaustion during autonomous dispatch: 'defer' (default; a fresh install is unchanged) waits for headroom; 'failover' rotates to the next non-exhausted provider in the active combo. A full-combo exhaustion falls back to defer; any unknown value degrades to 'defer'."
    },
    {
      "path": "dispatch.cutover_low_after_minutes",
      "type": "int",
      "default": 0,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Minutes after which a LOW (not yet exhausted) quota window whose reset is FARTHER out than this arms a cross-harness cutover instead of a wait. Default 0 = off (a fresh install is unchanged). The predicate is inverted from the defer horizon on purpose: for deferring a distant reset means wait, for cutover it means leave now. Needs dispatch.on_exhaustion='failover' and a healthy candidate in the active combo; any non-integer or negative value degrades to 0."
    },
    {
      "path": "dispatch.blueprint_floor",
      "type": "str",
      "default": "high",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "The blueprint floor for a plan-less node (lean dispatch). 'high' (the default) routes a plan-less node to /blueprint only when its difficulty is high, its size is L, or an open premise question blocks it (the premise-question tag); every other plan-less node goes straight to /target, which states its own scope. 'medium' restores the pre-lean table (blueprint for medium and up). 'low' blueprints every plan-less node; 'never' targets everything. The lead check-in routes each unplanned row through the same table: blueprint candidates against the one-per-lead ceiling, the rest print as target-ready. Any unknown value degrades to 'high'."
    },
    {
      "path": "routing.objective",
      "type": "str",
      "default": "cheapest-that-clears",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How the grid orders candidates that already clear the band: cheapest-that-clears (default), best-available, or prefer-harness. A value outside those three degrades to the default, so a typo can never select an objective nobody named."
    },
    {
      "path": "routing.prefer_harness",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "The harness the prefer-harness objective favors. A tiebreaker WITHIN a band, never a reason to lower one."
    },
    {
      "path": "sideline.colors.harness",
      "type": "dict[str, str]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Lane colors keyed by harness name (e.g. codex = \"cyan\"). The cascade's coarsest config key; see sideline.colors.route."
    },
    {
      "path": "sideline.colors.route",
      "type": "dict[str, str]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Lane colors keyed by the vendor lane the row bills (route, else provider), e.g. openrouter = \"magenta\". The DEFAULT colored axis: it separates bills where harness and model each fail alone."
    },
    {
      "path": "sideline.colors.model",
      "type": "dict[str, str]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Lane colors keyed by the recorded model string, quoted (\"glm-5.3-flash[1m]\" = \"green\"). Rendered verbatim; never imply an alias resolved."
    },
    {
      "path": "sideline.colors.row",
      "type": "dict[str, str]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Lane colors keyed by a [[routing.models]] row NAME (row.zai-glm-flash = \"orange\"). A row's own `color` field outranks this table for the same row."
    },
    {
      "path": "sideline.layout",
      "type": "typing.Literal['card', 'list']",
      "default": "card",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "The sideline's row shape: \"card\" renders each session as a padded two-line card (state glyph, name, PR, then harness, lead, message, age); \"list\" (default) keeps the one-row table. An unknown value reads as list; a change takes effect on the next attach."
    },
    {
      "path": "split.opens",
      "type": "typing.Literal['pane', 'portal']",
      "default": "pane",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Where the mux row menu's Split Direction toggle starts: pane (default) | portal. The t key flips it inside the open menu, and the flip lands here."
    },
    {
      "path": "auto_continue.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Auto-dispatch the next ready node after a PR merges."
    },
    {
      "path": "keep_going.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Autonomous keep-going: the merged-PR ritual classifies surviving carve-outs and dispatches follow-up /think or /target work (firehose-capped via think_spawn.daily_cap)."
    },
    {
      "path": "think_spawn.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Born-with-why: spawn/offer a context-carrying /think for a generated idea node; actual launches use the shared config.dispatch harness and substrate."
    },
    {
      "path": "think_spawn.max_per_run",
      "type": "int",
      "default": 5,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Blast-radius cap on /think spawns per node-generation run."
    },
    {
      "path": "think_spawn.idle_threshold_s",
      "type": "int",
      "default": 0,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Idle seconds before an attended operator downgrades to away (0 = off)."
    },
    {
      "path": "think_spawn.on_work_start",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "A2: dispatch a context /think when /target claims a node to work it (default OFF)."
    },
    {
      "path": "think_spawn.daily_cap",
      "type": "int",
      "default": 20,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Per-install per-day ceiling on /think spawns (firehose guard; 0 = off)."
    },
    {
      "path": "think_spawn.on_decompose_wave0",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Dispatch a /think for each WAVE-0 child at `fno backlog decompose` (default OFF; inherits max_per_run and daily_cap). Worth it only when the epic is large enough that inline-filling every child blows one session's context budget."
    },
    {
      "path": "think_spawn.substrate",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Deprecated compatibility fallback for existing configs; used only when dispatch.substrate is unset. Configure new routing under config.dispatch."
    },
    {
      "path": "think_spawn.attended",
      "type": "str",
      "default": "offer",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Attended born-with-why behavior: 'offer' (default, handoff line) or 'spawn' (real bg /think)."
    },
    {
      "path": "active_backlog.enabled",
      "type": "bool | dict[str, bool]",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Always-on backlog drain: true (every project) or a per-project map."
    },
    {
      "path": "active_backlog.interval",
      "type": "str",
      "default": "5m",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Poll-floor cadence for the drain daemon (e.g. 5m, 30s)."
    },
    {
      "path": "active_backlog.failure_limit",
      "type": "int",
      "default": 3,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Consecutive dispatch failures before a node is parked."
    },
    {
      "path": "parallel.max_lanes",
      "type": "int",
      "default": 1,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Deprecated and ignored: the epic advance's width derives from spawn-gate headroom (agents.max_live, provider lanes). The key stays parseable for one release; delete it from config."
    },
    {
      "path": "auto_merge.enabled",
      "type": "bool",
      "default": false,
      "tier": "always",
      "question": "Auto-merge PRs once checks pass and the review posture is satisfied?",
      "default_source": "",
      "doc": "Auto-merge a PR once CI is green AND the review posture is satisfied. There is no 'external review' step unless the review posture demands one: with review.posture below self_review (the floor) the merge refuses and names the rung to set. Read review.posture for what the rung requires before enabling this."
    },
    {
      "path": "auto_merge.grant",
      "type": "str",
      "default": "none",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "WHO may merge once enabled passes (actor scope): 'none' = humans only via `fno do pr merge`; 'dispatch' = autonomously dispatched /target workers may merge too. Replaces the deprecated dispatch.auto_merge bool. Any unknown value degrades to 'none'."
    },
    {
      "path": "auto_merge.merge_strategy",
      "type": "str",
      "default": "merge",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Merge strategy: merge | squash | rebase."
    },
    {
      "path": "auto_merge.delete_branch_on_merge",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Delete the remote branch after a merge. Honored on every path: the executor merges (`fno do pr merge`, pr verify) delete it inline, and a merge GitHub's own auto-merge queue lands later is cleaned up by the PR watcher when it observes the merge."
    },
    {
      "path": "auto_merge.require_checks_pass",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Require CI green before auto-merge."
    },
    {
      "path": "auto_merge.require_fresh_ci",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Require green pull_request checks to have run against the current base tip."
    },
    {
      "path": "auto_heal.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Arm the CI healer: each tick spawns one detached pr-heal --all --apply drive loop over every project root, off the tick's own budget. Default false. Measured 2026-09-16 over 15 red open PRs: 1 push, 3 cancelled-run reruns, 11 escalations, 0 failures inherited from main. Arm with: fno config set auto_heal.enabled true."
    },
    {
      "path": "pr_watch.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Enable the global PR-state watcher daemon."
    },
    {
      "path": "recovery.enabled",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Enable the bg-session recovery sweep: provider failover on swap-class deaths plus close-surfacing for finished-but-lingering sessions (rides the pr_watch tick). Assumes bypass workers (the config.agents.defaults.permission_mode built-in for autonomous dispatch); a non-bypass worker cannot run autonomously and is not resumed."
    },
    {
      "path": "recovery.watchdog.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Whether the external fleet watchdog lane runs on the pr_watch tick (default false). The depth it goes to is recovery.watchdog.mode."
    },
    {
      "path": "recovery.watchdog.mode",
      "type": "typing.Literal['report', 'wake', 'handoff']",
      "default": "report",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How far an enabled watchdog lane goes: report (default; publish the unfinished-work report: in_progress nodes with free claims, done branches ahead of origin/main, dirty ownerless worktrees, and ownerless open PRs (a PR whose owner reads unknown waits 24h), each finding naming its clearing command) | wake (report, plus resume positively stalled sessions) | handoff (also permit a proved cross-provider outage transaction). Reroute never fires from a tick; it needs a manual `fno agents fleet watchdog --apply-all`."
    },
    {
      "path": "recovery.watchdog.mail_to",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Mail handle the unfinished-work digest is pushed to when the finding set changes (agent name, short id, or project:<slug>). Empty (default) mails nobody."
    },
    {
      "path": "recovery.startup_destructive",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Whether daemon startup may archive orphan state directories and rewrite dead-PID rows as exited. Defaults false so restart recovery preserves every resume record."
    },
    {
      "path": "health_monitor.enabled",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Enable backlog health monitoring."
    },
    {
      "path": "resource_meter.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Whole-machine resource meter (needs macmon on PATH, Apple Silicon only; brew install macmon). Off by default because fno core does not depend on the binary."
    },
    {
      "path": "resource_meter.refresh_seconds",
      "type": "int",
      "default": 5,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How often the status-row meter re-samples the machine (seconds)."
    },
    {
      "path": "work.workspaces",
      "type": "dict[str, WorkspaceEntry]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "auto-detect",
      "doc": "Workspace -> project topology map (config.work.workspaces.<slug>.projects[]). A project entry may carry a `worktree` key (never|harness-native|external) overriding config.worktree.policy."
    },
    {
      "path": "join.sandbox",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "When workers join a held node, sandbox each joiner to its own band's files?",
      "default_source": "default",
      "doc": "Enforce a per-joiner write partition on `fno backlog join`: one switch over BOTH layers (the sandbox denyWrite of peer bands' surfaces plus the state-dir allowWrite, composed into the worker's --settings, and the Edit/Write guard). An overlapping or unevaluated band is never narrowed; the node holder is never sandboxed."
    },
    {
      "path": "worktree.policy",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Global worktree-isolation policy (never|harness-native|external); default harness-native. `never` launches code payloads in place (e.g. an Obsidian vault checkout). A per-project work.workspaces.<slug>.projects[].worktree key overrides it."
    },
    {
      "path": "worktree.auto_install",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Run dependency install when a new worktree is set up (read by hooks/worktree-setup.sh and worktree-manager.sh); set false to skip it. Default true."
    },
    {
      "path": "worktree.setup_command",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Explicit setup command run after a new worktree is created, whatever auto_install says (read by hooks/worktree-setup.sh and worktree-manager.sh). Default empty."
    },
    {
      "path": "worktree.skip_verification",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Skip the post-setup verification step in a new worktree (read by hooks/worktree-setup.sh). Default false."
    },
    {
      "path": "worktree.test_command",
      "type": "str",
      "default": "",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Verification command for a new worktree (read by hooks/worktree-setup.sh); falls back to the script's own detection when empty. Default empty."
    },
    {
      "path": "worktree.prune_done",
      "type": "str",
      "default": "balanced",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "How far the merged sweep's done-node arm goes on a done tree with uncommitted tracked changes: balanced (default) keeps the tree and reports the diff; aggressive salvages the tracked diff to refs/fno/salvage/<node>, then prunes once the 30m grace passes and no live session holds the tree. Both keep the branch, salvage untracked files, and still block on conflicts, unborn trees, unreadable probes, live claims, and live sessions."
    },
    {
      "path": "model_routing.enabled",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "Route auxiliary coordination work to a secondary model provider (production stays on Anthropic)?",
      "default_source": "",
      "doc": "Route auxiliary roles (coordinate/tidy/orient/consolidate/post-merge) and the opt-in build lane to a secondary provider at spawn."
    },
    {
      "path": "mux.shell_integration",
      "type": "str",
      "default": "mux-panes",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Auto-inject OSC 133 block markers into mux-spawned shells: mux-panes (default) | off. Never edits your global shell rc."
    },
    {
      "path": "mux.restore.hold_workers",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Rebuild named held panes for pane-substrate workers after a mux server restart; focusing a held pane resumes its persisted harness session (default on)."
    },
    {
      "path": "mux.restore.policy",
      "type": "typing.Literal['hold', 'idle', 'resume'] (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Startup restore policy for worker members: hold (rebuild named held panes, resume on focus, skip tabs whose every slot binds a done worker, default), idle (members stay idle rows), or resume (relaunch every member that is not tombstoned, gone, or reap-retired, finished work included). The policy never decides the tab count by itself: tabs rebuild from the stored tab trees under every value, so no value restores zero tabs. Overrides hold_workers when set."
    },
    {
      "path": "mux.board_scope",
      "type": "str",
      "default": "repo",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Which projects the mux backlog board shows: repo (default, this checkout's project.id) | all | workspace:<name>, e.g. workspace:main for a workspace holding web, backend and marketing. A scope that cannot resolve falls back to every project, and `fno mux doctor` reports that as a warn naming the remedy. Latched at mux server birth; `fno mux kill-server` re-reads."
    },
    {
      "path": "mux.prefix",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "The mux prefix key, as C-a / Ctrl-a / ^a or a bare printable character. A digit 1-9 is refused (those select tabs), as is a key an action already holds. Unset keeps the built-in Ctrl-b."
    },
    {
      "path": "mux.keys",
      "type": "dict[str, str]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Per-action key rebinds (action -> key), e.g. detach: 'Q'. Action ids are the ones prefix+? lists. An unreadable key, an unknown action, a digit (1-9 select tabs), or a collision is refused and reported rather than silently ignored. The sideline action map and the Ctrl+Opt+Left global chord: docs/mux-keys.md."
    },
    {
      "path": "mux.notify_on_blocked",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Fire an OS notification when an agent badge enters 'blocked' (default on)."
    },
    {
      "path": "mux.notify_on_done",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Also notify on a terminal 'done' hook transition (default off)."
    },
    {
      "path": "mux.attach_digest",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Show a 'while you were gone' catch-up digest overlay on attach after an absence (default on)."
    },
    {
      "path": "mux.attach_digest_threshold_min",
      "type": "int",
      "default": 10,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Minutes since last detach before the catch-up digest overlay shows (default 10)."
    },
    {
      "path": "mux.hover_focus",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Focus-follows-mouse: hovering a coding pane makes it the keyboard focus after a short settle (default on)."
    },
    {
      "path": "mux.status_row",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Show the mux status row at the bottom of the terminal (default on)."
    },
    {
      "path": "mux.load_readout",
      "type": "typing.Literal['simple', 'detailed']",
      "default": "simple",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "How the mux shows machine load: simple (default) says it in plain words, e.g. 'CPU 80% busy: agents 58%, everything else 22%'; detailed shows the raw numbers (cores, load averages, GB). Both draw a CPU graph. Latched at mux client start."
    },
    {
      "path": "mux.theme",
      "type": "str (optional)",
      "default": null,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Mux chrome theme: footnote-superscript (default, the brand dark palette) | footnote-paper (auto-picked on a light terminal background) | terminal (no-op, inherits the emulator colors) | catppuccin | tokyo-night | gruvbox. A named palette recolors the chrome while the body stays the emulator's inverse block. Set from the settings picker. Role overrides: quote-dotted keys in [mux] - \"theme.brand\", \"theme.needs_you\" and \"theme.border\" take #rrggbb values that hold under any theme, and every role also takes `default` to pin that role to the terminal's own text color (white on a dark ground, black on paper); theme.border recolors every border at once (the pane frame, the modal outlines). The tab-bar mark's stamp takes no override."
    },
    {
      "path": "mux.paint_background",
      "type": "bool",
      "default": true,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "While a footnote theme is active, paint the terminal's own background, foreground and 16-color palette from the theme (OSC 11/10/4) and restore them on exit (default on)."
    },
    {
      "path": "mux.card_graph",
      "type": "typing.Literal['activity', 'context']",
      "default": "activity",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "What the sideline card's graph slot plots: activity (default) draws the tool-activity ramp colored ok/warn/error per interval, context draws the context percent's fill bar, steady for the whole session. Latched at mux client start."
    },
    {
      "path": "mux.open_with",
      "type": "typing.Literal['inmux', 'obsidian', 'system']",
      "default": "inmux",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Where a clicked file path opens: inmux (default; text, source files, images and PDFs open in the mux viewer, other files in the platform opener) | obsidian (files under the configured vault open in Obsidian, others fall back to system) | system (the platform opener). Read by the Rust client."
    },
    {
      "path": "mux.viewer",
      "type": "typing.Literal['panel', 'modal']",
      "default": "panel",
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Shape of the in-mux file viewer: panel (default, docks at the right edge) | modal. Read by the Rust client."
    },
    {
      "path": "mux.wheel_lines",
      "type": "int",
      "default": 1,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Lines one wheel notch scrolls a pane whose app does NOT own the mouse (default 1). A notch here is one cell of trackpad travel; a wheel-mouse user wanting the classic 3-detent step sets 3. Read once at mux server birth."
    },
    {
      "path": "mux.wheel_passthrough_rate",
      "type": "int",
      "default": 3,
      "tier": "advanced",
      "question": "",
      "default_source": "default",
      "doc": "Wheel ticks forwarded per 100ms to a pane whose app DOES own the mouse (default 3). The app scrolls its own step per tick, so this caps how fast a trackpad flick moves a Claude Code / Codex pane. Raise it if a deliberate notch scroll ever drops."
    },
    {
      "path": "loops",
      "type": "dict[str, LoopEntry]",
      "default": {},
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Per-loop level overrides: {<name>: {level: report|assisted|unattended}} (default report)."
    },
    {
      "path": "status_sinks",
      "type": "list[StatusSinkConfig]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Status-fanout subscribers: list of {name, type (json-webhook|text-webhook|backlog-progress), events, match, url|url_env, template, field, cloudevents, enabled}."
    },
    {
      "path": "status_fanout.interval_secs",
      "type": "int",
      "default": 5,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Seconds between status-fanout ticks per project (daemon host)."
    },
    {
      "path": "status_fanout.http_timeout_secs",
      "type": "int",
      "default": 5,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Bounded per-webhook HTTP timeout for a status sink."
    },
    {
      "path": "status_fanout.retries",
      "type": "int",
      "default": 2,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Retry budget per webhook dispatch before drop/short-circuit."
    },
    {
      "path": "status_fanout.short_circuit_backoff_secs",
      "type": "int",
      "default": 300,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Seconds a short-circuited status sink stays parked before the next retry; 0 retries every tick."
    },
    {
      "path": "lead.enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Arm the lead loop: hold a lead session open while its board names work it can shrink. Defaults false."
    },
    {
      "path": "lead.autonomous_merge",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Let the lead merge a green mergeable PR. Defaults false; until set, a mergeable PR is reported and never counted as the lead's own work."
    },
    {
      "path": "lead.wake_enabled",
      "type": "bool",
      "default": false,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Arm the pr-watch tick's wake phase: respawn a lead whose holder is gone when mail, a board change, or the timer backstop calls for it. Needs the pr-watcher LaunchAgent loaded (RunAtLoad is false by design). Defaults false."
    },
    {
      "path": "lead.wake_ceiling",
      "type": "int",
      "default": 32,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Wakes allowed per scope per ROLLING 24h (default 32, ~1.5x the worst measured day). Never a lifetime constant: a lifetime cap strands a long-lived lead."
    },
    {
      "path": "lead.wake_debounce_seconds",
      "type": "int",
      "default": 900,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Minimum gap between billed wakes (default 900): a lead woken inside the window is still working under its own in-session arm."
    },
    {
      "path": "lead.wake_backstop_seconds",
      "type": "int",
      "default": 1800,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Timer-backstop interval (default 1800). An approximation of the mail and board-change triggers, kept so a missed event cannot strand a scope forever; the interval is a policy choice, not a measurement."
    },
    {
      "path": "lead.blocked_child_grace_minutes",
      "type": "int",
      "default": 30,
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "Minutes a blocked distress row may sit unanswered before the blocked_child board queue surfaces it (default 30). An answer is mail to that session, a claim release on the node, or the node closing."
    },
    {
      "path": "lead.implementation_guard",
      "type": "str",
      "default": "refuse",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "What a titled org session may write through the lead-delegation-guard hook. refuse (default) denies a write whose target resolves inside the repo, outside its .fno state tree, build output and any lead.write_roots entry, and names the rejected path. warn prints the refusal on stderr and allows, so a lead adopts the guard without a surprise. off silences the guard. An unknown value degrades to refuse."
    },
    {
      "path": "lead.write_roots",
      "type": "list[str]",
      "default": [],
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "In-repo paths a titled org session may still write through the lead-delegation-guard hook. A relative entry resolves against the repo root, and a leading ~/ against $HOME. The match is by realpath, so a symlinked entry covers its target. Default empty: every in-repo path outside .fno and build output is source and refused. A blank entry is dropped. '.' allows the whole repo, the same as implementation_guard = off. Paths outside the repo always allow and need no entry."
    },
    {
      "path": "lead.checkin_interval",
      "type": "str",
      "default": "55m",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "The /loop interval a lead self-injects on Claude (default 55m, under the one-hour prompt cache). Fail-safe: a value that is not <digits>[smhd] degrades to 55m at load, never raises."
    },
    {
      "path": "lead.checkin_text",
      "type": "str",
      "default": "lead check-in. Run fno agents org checkin: it gathers the check-in readings, prints them, diffs the last beat, and journals lead_checkin. Then act on the printout per the lead skill. When nothing changed and coverage is full, print 'no change' and stop. This beat is a heartbeat. ",
      "tier": "advanced",
      "question": "",
      "default_source": "",
      "doc": "The /loop prompt text a lead self-injects at each check-in (default: run fno agents org checkin, which gathers the readings, diffs the last beat, and journals lead_checkin; print 'no change' when idle)."
    }
  ]
}
