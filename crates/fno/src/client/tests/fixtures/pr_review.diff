+
+/// Run the mail send and word the receipt from its exit: sent on 0, not
+/// reached on a refusal. Past `bound` the child keeps running detached, because
+/// a slow send still lands. Stderr goes to a file, since a pipe would break the
+/// child once this process exits.
+fn deliver_pointer(
+    mut command: std::process::Command,
+    holder: &str,
+    bound: std::time::Duration,
+) -> String {
+    use std::process::Stdio;
+    let err_path = std::env::temp_dir().join(format!(
+        "fno-note-notice-{}-{:?}.err",
+        std::process::id(),
+        std::thread::current().id()
+    ));
+    let not_reached = |why: &str| format!("holder {holder} not reached here: {why}");
+    let Ok(err_file) = std::fs::File::create(&err_path) else {
+        return not_reached("could not open a stderr file");
+    };
+    command
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(err_file);
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(e) => return not_reached(&e.to_string()),
+    };
+    let started = std::time::Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Some(status),
+            Ok(None) if started.elapsed() < bound => {
+                std::thread::sleep(std::time::Duration::from_millis(25))
+            }
+            _ => break None,
+        }
+    };
+    let stderr = std::fs::read_to_string(&err_path).unwrap_or_default();
+    let _ = std::fs::remove_file(&err_path);
+    match status {
+        Some(status) if status.success() => format!("pointer sent to {holder}"),
+        Some(status) => {
+            // The refusal is the last line; a sender warning can precede it.
+            let why = stderr.lines().rev().find(|l| !l.trim().is_empty());
+            not_reached(why.unwrap_or(&format!("mail send exit {:?}", status.code())))
+        }
+        None => format!("pointer to {holder} still sending after {}s", bound.as_secs()),
+    }
 }
 
