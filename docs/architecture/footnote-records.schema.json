{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/bllshttng/footnote/blob/main/docs/architecture/footnote-records.schema.json", "title": "footnote session record v1", "description": "One line of a session record. The prose spec is footnote-transcript-schema.md beside this file. A reader refuses a type it does not know unless the line is ignorable.", "oneOf": [{"$ref": "#/$defs/header"}, {"$ref": "#/$defs/turn_context"}, {"$ref": "#/$defs/user_input"}, {"$ref": "#/$defs/model_request"}, {"$ref": "#/$defs/model_attempt"}, {"$ref": "#/$defs/model_response"}, {"$ref": "#/$defs/usage"}, {"$ref": "#/$defs/tool_call"}, {"$ref": "#/$defs/effect_decision"}, {"$ref": "#/$defs/tool_start"}, {"$ref": "#/$defs/tool_result"}, {"$ref": "#/$defs/hook_decision"}, {"$ref": "#/$defs/compaction"}, {"$ref": "#/$defs/terminal"}, {"$ref": "#/$defs/heartbeat"}, {"$ref": "#/$defs/hook_run"}, {"$ref": "#/$defs/footnotes"}, {"$ref": "#/$defs/footnotes_post"}, {"$ref": "#/$defs/mcp_servers"}, {"$ref": "#/$defs/child_session"}],
  "$defs": {
    "envelope": {"type": "object", "required": ["v", "seq", "id", "ts", "session_id", "type", "data"], "properties": {"v": {"const": 1}, "seq": {"type": "integer", "minimum": 0}, "id": {"type": "string"}, "ts": {"type": "string", "format": "date-time"}, "session_id": {"type": "string"}, "type": {"type": "string"}, "data": {"type": "object"}, "ignorable": {"const": true}}},
    "claim": {"type": "object", "required": ["text", "verdict"], "properties": {"n": {"type": "integer"}, "text": {"type": "string"}, "verdict": {"enum": ["accepted", "missing", "rejected", "unverifiable", "stale", "not_run"]}, "reason_code": {"type": ["string", "null"]}, "check": {}, "footnotes": {"type": "array", "items": {"$ref": "#/$defs/footnote"}}}},
    "footnote": {"type": "object", "required": ["source", "verdict"], "properties": {"mark": {"type": "integer"}, "source": {"type": "string"}, "verdict": {"enum": ["accepted", "missing", "rejected", "unverifiable", "stale"]}, "reason_code": {"type": ["string", "null"]}, "kind": {"enum": ["diff", "run", "read", "turn", "pr", "tool", null]}, "record_id": {}, "seq": {}, "label": {}}},
    "header": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "header"}, "data": {"type": "object", "required": ["session_id", "cwd", "harness"], "properties": {"session_id": {}, "cwd": {}, "harness": {}, "commit": {}, "branch": {}, "fno_version": {}, "parent_session_id": {}, "forked_from": {}, "node": {}, "plugin_root": {}, "model": {}, "wire": {}, "system_prompt": {}, "hook_sources": {}, "permission_mode": {}, "permission_mode_source": {}, "permission_sources": {}, "agent": {}, "mcp_servers": {}}}}},
    "turn_context": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "turn_context"}, "data": {"type": "object", "required": ["turn"], "properties": {"turn": {}, "model": {}, "cwd": {}, "spent_usd": {}, "wall_secs": {}, "cost_cap_usd": {}, "wall_cap_secs": {}, "permission_mode": {}}}}},
    "user_input": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "user_input"}, "data": {"type": "object", "required": ["text", "origin"], "properties": {"text": {}, "origin": {"enum": ["operator", "hook", "skill", "agent", "footnotes", "mail"]}, "sender_session_id": {}, "message_id": {}, "reply_to": {}}}}},
    "model_request": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "model_request"}, "data": {"type": "object", "required": ["turn"], "properties": {"turn": {}, "provider_id": {}, "endpoint_host": {}, "wire": {}, "route": {}, "requested_model": {}, "message_count": {}, "estimated_input_tokens": {}, "body_sha256": {}}}}},
    "model_attempt": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "model_attempt"}, "data": {"type": "object", "required": ["attempt"], "properties": {"attempt": {}, "status": {}, "error_class": {}, "detail": {}, "latency_ms": {}, "usage": {}}}, "ignorable": {"const": true}}, "required": ["ignorable"]},
    "model_response": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "model_response"}, "data": {"type": "object", "required": ["turn"], "properties": {"turn": {}, "provider_response_id": {}, "reported_model": {}, "content": {}, "stop_reason": {}, "latency_ms": {}, "attempts": {}}}}},
    "usage": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "usage"}, "data": {"type": "object", "required": ["turn"], "properties": {"turn": {}, "provider_response_id": {}, "input_tokens": {}, "output_tokens": {}, "cache_read_tokens": {}, "cache_write_tokens": {}, "cost_usd": {}}}}},
    "tool_call": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "tool_call"}, "data": {"type": "object", "required": ["tool_call_uid", "name"], "properties": {"tool_call_uid": {}, "name": {}, "turn": {}, "provider_tool_call_id": {}, "raw_input": {}, "input": {}, "parse_error": {}}}}},
    "effect_decision": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "effect_decision"}, "data": {"type": "object", "required": ["tool_call_uid", "verdict"], "properties": {"tool_call_uid": {}, "verdict": {}, "effect_class": {}, "effect_capable": {}, "source": {}, "rule": {}, "reason": {}, "hook_decision": {}, "mode": {}, "settings_path": {}, "principal": {}}}}},
    "tool_start": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "tool_start"}, "data": {"type": "object", "required": ["tool_call_uid"], "properties": {"tool_call_uid": {}}}}},
    "tool_result": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "tool_result"}, "data": {"type": "object", "required": ["tool_call_uid"], "properties": {"tool_call_uid": {}, "disposition": {"enum": ["none", "applied", "unknown"]}, "is_error": {}, "model_text": {}, "size": {}, "sha256": {}, "spill_path": {}, "child_session_id": {}, "child_transcript": {}, "child_cost_usd": {}}}}},
    "hook_decision": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "hook_decision"}, "data": {"type": "object", "required": ["event"], "properties": {"event": {}, "source": {}, "verdict": {}, "rule": {}, "reason": {}, "context": {}}}}},
    "compaction": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "compaction"}, "data": {"type": "object", "required": ["summary"], "properties": {"summary": {}, "tokens_before": {}, "tokens_after": {}, "trigger": {}, "retained_tail": {}, "messages": {}, "plan_path": {}, "plan_anchor": {}, "plan_anchor_sha256": {}, "plan_anchor_missing": {}, "replaced_seq_range": {}}}}},
    "terminal": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "terminal"}, "data": {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["done", "budget", "refused", "interrupted", "error"]}, "reason": {}, "turns": {}, "tool_calls": {}, "input_tokens": {}, "output_tokens": {}, "cost_usd": {}}}}},
    "heartbeat": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "heartbeat"}, "data": {"type": "object", "required": ["state", "turn", "spent_usd", "wall_secs", "pid"], "properties": {"state": {"enum": ["working", "waiting_permission", "idle"]}, "turn": {}, "spent_usd": {}, "wall_secs": {}, "pid": {}}}, "ignorable": {"const": true}}, "required": ["ignorable"]},
    "hook_run": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "hook_run"}, "data": {"type": "object", "required": ["event"], "properties": {"event": {}, "command": {}, "source": {}, "exit": {}, "duration_ms": {}, "error": {}}}, "ignorable": {"const": true}}, "required": ["ignorable"]},
    "footnotes": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "footnotes"}, "data": {"type": "object", "required": ["claims", "ending"], "properties": {"claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}, "ending": {}, "gist": {}, "claims_total": {}, "claims_accepted": {}, "claims_missing": {}, "claims_rejected": {}, "claims_unverifiable": {}, "claims_stale": {}, "checks": {}, "next": {}, "first_draft": {}, "signals": {}, "tests_touched": {}, "via": {}, "reasked": {}, "head_sha": {}, "attester_session_id": {}, "reviewer": {}}}, "ignorable": {"const": true}}, "required": ["ignorable"]},
    "footnotes_post": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "footnotes_post"}, "data": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["posted", "failed", "skipped"]}, "reason": {}, "action": {}, "comment_id": {}, "pr": {}, "url": {}, "head_sha": {}}}, "ignorable": {"const": true}}, "required": ["ignorable"]},
    "mcp_servers": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "mcp_servers"}, "data": {"type": "object", "required": ["servers"], "properties": {"servers": {}, "tools": {}}}, "ignorable": {"const": true}}, "required": ["ignorable"]},
    "child_session": {"allOf": [{"$ref": "#/$defs/envelope"}], "properties": {"type": {"const": "child_session"}, "data": {"type": "object", "required": ["tool_call_uid", "child_session_id"], "properties": {"tool_call_uid": {}, "child_session_id": {}, "child_transcript": {}}}, "ignorable": {"const": true}}, "required": ["ignorable"]}
  }
}
