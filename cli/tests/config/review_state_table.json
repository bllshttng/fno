{
  "comment": "The shared oracle for review_state derivation from per-reviewer verdicts. Two Rust tests walk these rows: one through CoverageReport::review_state_at, one through the stored row in pr_status::reviews. `fail_at_head` is the classifier's flag for a fail round that still describes the head. A verdict without a `required` key reads REQUIRED: that is every row emitted before the field existed.",
  "rows": [
    {
      "name": "optional_refused_only_is_unreviewed",
      "expected_state": "unreviewed",
      "verdicts": [
        {
          "producer": "github_app",
          "name": "chatgpt-codex-connector",
          "verdict": "refused",
          "required": false
        }
      ]
    },
    {
      "name": "required_refused_names_the_state",
      "expected_state": "reviewer_refused",
      "verdicts": [
        {
          "producer": "github_app",
          "name": "chatgpt-codex-connector",
          "verdict": "refused",
          "required": true
        }
      ]
    },
    {
      "name": "local_refusal_is_always_owed",
      "expected_state": "reviewer_refused",
      "verdicts": [
        {
          "producer": "local_attestation",
          "name": "code-review",
          "verdict": "refused"
        }
      ]
    },
    {
      "name": "reviewed_outranks_refused",
      "expected_state": "reviewed",
      "verdicts": [
        {
          "producer": "github_app",
          "name": "chatgpt-codex-connector",
          "verdict": "refused",
          "required": true
        },
        {
          "producer": "github_app",
          "name": "gemini-code-assist",
          "verdict": "reviewed",
          "required": true,
          "reviewed_sha": "head",
          "freshness": "fresh"
        }
      ]
    },
    {
      "name": "a_row_with_no_required_key_reads_required",
      "expected_state": "reviewer_refused",
      "verdicts": [
        {
          "producer": "github_app",
          "name": "chatgpt-codex-connector",
          "verdict": "refused"
        }
      ]
    },
    {
      "name": "spent_budget_stale_local_reads_reviewed",
      "expected_state": "reviewed",
      "rounds_exhausted": true,
      "verdicts": [
        {
          "producer": "local_attestation",
          "name": "code-review",
          "verdict": "stale",
          "freshness": "stale",
          "reviewed_sha": "444500be"
        },
        {
          "producer": "github_app",
          "name": "chatgpt-codex-connector",
          "verdict": "refused",
          "required": false
        }
      ]
    },
    {
      "name": "under_budget_stale_local_reads_unreviewed",
      "expected_state": "unreviewed",
      "rounds_exhausted": false,
      "verdicts": [
        {
          "producer": "local_attestation",
          "name": "code-review",
          "verdict": "stale",
          "freshness": "stale",
          "reviewed_sha": "444500be"
        },
        {
          "producer": "github_app",
          "name": "chatgpt-codex-connector",
          "verdict": "refused",
          "required": false
        }
      ]
    },
    {
      "name": "fail_at_head_reads_findings_open",
      "expected_state": "findings_open",
      "fail_at_head": true,
      "verdicts": []
    },
    {
      "name": "retraction_stays_unreviewed",
      "expected_state": "unreviewed",
      "fail_at_head": false,
      "verdicts": []
    },
    {
      "name": "refused_outranks_findings_open",
      "expected_state": "reviewer_refused",
      "fail_at_head": true,
      "verdicts": [
        {
          "producer": "local_attestation",
          "name": "code-review",
          "verdict": "refused"
        }
      ]
    }
  ]
}
